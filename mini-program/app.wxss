@import "./styles/tokens.wxss";

page { height: 100%; background: var(--sg-bg); }
.page-wrap {
  height: 100%;
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  background: var(--sg-bg);
}
.page-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}
.page-content {
  padding: 28rpx 36rpx 40rpx;
  box-sizing: border-box;
}
.section-title {
  font-size: var(--sg-font-section);
  font-weight: 600;
  line-height: 1.4;
}
.muted {
  color: var(--sg-muted);
}
.small {
  font-size: var(--sg-font-note);
}
.strong {
  font-weight: 600;
}
.primary {
  min-height: 96rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sg-brand);
  color: var(--sg-on-brand);
  border-radius: var(--sg-radius-button);
  font-size: var(--sg-font-label);
  font-weight: 600;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  border: 0;
  line-height: 1.4;
}
.secondary {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--sg-radius-button);
  background: var(--sg-soft);
  color: var(--sg-text);
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  font-size: var(--sg-font-body);
}
.primary.disabled,
.primary[disabled],
.secondary.disabled,
.secondary[disabled] {
  background: var(--sg-disabled-bg);
  color: var(--sg-disabled-text);
  opacity: 1;
}
button.primary, button.secondary {
  margin: 0;
  font-family: var(--sg-font-family);
}
button.primary::after, button.secondary::after { border: 0; }
.secondary { font-weight: 600; border: 1rpx solid var(--sg-line); }
.link[aria-disabled="true"] { color: var(--sg-disabled-text); }
.primary .loading-spinner { margin-right: 16rpx; }
.footer-actions { flex-shrink: 0; }

.pressed {
  opacity: 0.7;
}
.row {
  display: flex;
  align-items: center;
}
.between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.link {
  color: var(--sg-brand);
  font-size: var(--sg-font-body);
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-state {
  text-align: center;
  padding: 100rpx 24rpx 40rpx;
}
.empty-icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--sg-soft);
  color: var(--sg-brand);
}
.empty-title {
  font-size: var(--sg-font-section);
  font-weight: 600;
  margin-bottom: 16rpx;
}
.empty-desc {
  font-size: var(--sg-font-body);
  color: var(--sg-muted);
  line-height: 1.8;
  margin-bottom: 32rpx;
}
.footer-actions {
  padding: 20rpx 36rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--sg-surface);
  border-top: 1rpx solid var(--sg-line);
  box-sizing: border-box;
}
.segment {
  display: flex;
  padding: 6rpx;
  border-radius: var(--sg-radius-control);
  background: var(--sg-soft);
}
.segment-item {
  flex: 1;
  padding: 18rpx 12rpx;
  text-align: center;
  font-size: var(--sg-font-body);
  color: var(--sg-muted);
  border-radius: var(--sg-radius-small);
}
.segment-item.active {
  background: var(--sg-surface);
  color: var(--sg-brand);
  font-weight: 600;
}
.error-inline {
  padding: 24rpx;
  color: var(--sg-danger);
  background: var(--sg-orange-soft);
  border-radius: var(--sg-radius-control);
  font-size: var(--sg-font-body);
  line-height: 1.7;
}
.notice {
  padding: 22rpx 24rpx;
  background: var(--sg-brand-soft);
  color: var(--sg-brand);
  font-size: var(--sg-font-note);
  border-radius: var(--sg-radius-control);
  line-height: 1.6;
}
.tool-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
@media (prefers-color-scheme: dark) {
  .primary {
    color: #102144;
  }
}
.crop-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}
.brand-canvas {
  position: absolute;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}
.preview-watermark-note {
  color: var(--sg-muted);
  font-size: var(--sg-font-caption);
  line-height: 1.6;
  text-align: center;
  margin-bottom: 12rpx;
}
.crop-line-a {
  position: absolute;
  left: 12rpx;
  top: 0;
  width: 32rpx;
  height: 32rpx;
  border-left: 3rpx solid var(--sg-text);
  border-bottom: 3rpx solid var(--sg-text);
  box-sizing: border-box;
}
.crop-line-b {
  position: absolute;
  left: 0;
  top: 12rpx;
  width: 32rpx;
  height: 32rpx;
  border-top: 3rpx solid var(--sg-text);
  border-right: 3rpx solid var(--sg-text);
  box-sizing: border-box;
}

.loading-spinner {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  background: currentColor;
  border-radius: 8rpx;
  animation: sg-loading-pulse 0.8s ease-in-out infinite alternate;
}
@keyframes sg-loading-pulse {
  from {
    opacity: 0.3;
    transform: scale(0.75);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.segment-item {
  min-height: 44px;
  box-sizing: border-box;
}

/* Shared campus geometry: decoration stays separate from live photos and controls. */
.campus-title {
  position: relative;
  display: flex;
  align-items: center;
  font-size: var(--sg-font-display);
  font-weight: 700;
  line-height: 1.35;
}
.campus-subtitle {
  margin-top: 12rpx;
  font-size: var(--sg-font-body);
  line-height: 1.6;
}
.campus-mark {
  width: 80rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: var(--sg-yellow);
  transform: rotate(-7deg);
  margin-top: 4rpx;
}
.campus-banner {
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  background: var(--sg-green);
  color: #fff;
  padding: 32rpx 36rpx 36rpx;
  border-radius: 24rpx 24rpx 0 0;
}
.campus-banner-title {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  font-size: var(--sg-font-title);
  font-weight: 700;
  line-height: 1.4;
}
.campus-track {
  position: absolute;
  right: -180rpx;
  bottom: -90rpx;
  width: 500rpx;
  height: 240rpx;
  transform: rotate(-20deg);
  pointer-events: none;
}
.campus-lane {
  position: absolute;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 50%;
  box-sizing: border-box;
}
.campus-lane-one {
  top: 0;
  left: 0;
  width: 500rpx;
  height: 240rpx;
}
.campus-lane-two {
  top: 26rpx;
  left: 26rpx;
  width: 448rpx;
  height: 188rpx;
}
.campus-lane-three {
  top: 52rpx;
  left: 52rpx;
  width: 396rpx;
  height: 136rpx;
}
.campus-spark {
  position: relative;
  width: 44rpx;
  height: 48rpx;
  margin-left: 14rpx;
  flex-shrink: 0;
  color: var(--sg-yellow);
}
.campus-spark-one,
.campus-spark-two {
  position: absolute;
  width: 8rpx;
  height: 26rpx;
  border-radius: 8rpx;
  background: currentColor;
}
.campus-spark-one {
  left: 8rpx;
  top: 2rpx;
  transform: rotate(28deg);
}
.campus-spark-two {
  left: 28rpx;
  top: 22rpx;
  transform: rotate(65deg);
}
.tone-green {
  color: var(--sg-green-ink);
  background: var(--sg-green-soft);
}
.tone-blue {
  color: var(--sg-brand);
  background: var(--sg-canvas);
}
.tone-orange {
  color: var(--sg-orange);
  background: var(--sg-orange-soft);
}
.primary t-icon {
  margin-left: 12rpx;
}
@media (prefers-reduced-motion: reduce) {
  .loading-spinner,
  .processing-dot {
    animation: none;
  }
}

/* Shared tool surface and compact secondary interactions. */
.tool-intro { margin: 8rpx 0 24rpx; }
.tool-title { font-size: var(--sg-font-section); font-weight: 600; line-height: 1.5; }
.tool-description { font-size: var(--sg-font-note); line-height: 1.7; color: var(--sg-muted); margin-top: 12rpx; }
.tool-stage { height: 440rpx; min-height: 180px; border-radius: var(--sg-radius-card); background: var(--sg-canvas); }
.tool-empty { padding: 32rpx; color: var(--sg-brand); text-align: center; font-size: var(--sg-font-label); font-weight: 600; }
.tool-empty .tool-description { font-weight: 400; }
.secondary[aria-disabled="true"] { background: var(--sg-disabled-bg); color: var(--sg-disabled-text); }
@media (max-height: 680px) { .tool-stage { height: 360rpx; min-height: 160px; } }

/* Skyline does not resolve max() in min-height. Keep physical touch targets on narrow screens. */
@media (max-width: 375px) {
  .primary { min-height: 48px; }
  .secondary, .link { min-height: 44px; }
}
