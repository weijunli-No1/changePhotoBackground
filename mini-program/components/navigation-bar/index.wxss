@import "../../styles/tokens.wxss";
.nav-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: var(--sg-bg);
  color: var(--sg-text);
}
.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  max-width: 350rpx;
}
.left-box {
  position: absolute;
  left: 12rpx;
  top: 0;
  bottom: 0;
  width: 100rpx;
  min-width: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-btn-pressed {
  opacity: 0.5;
}
@media (prefers-color-scheme: dark) {
  .nav-container {
    background: var(--sg-bg);
    color: var(--sg-text);
  }
}

.nav-brand {
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-logo { color: var(--sg-brand); }
.nav-inverse .nav-logo { color: #fff; }
.nav-inverse {
  background: #1b5147;
  color: #fff;
}

.nav-logo {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
