.nav-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: #fff;
  color: #17221f;
}
.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  text-align: center;
  max-width: 350rpx;
}
.left-box {
  position: absolute;
  left: 12rpx;
  top: 0;
  bottom: 0;
  width: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-btn-pressed {
  opacity: 0.5;
}
@media (prefers-color-scheme: dark) {
  .nav-container {
    background: #121212;
    color: #f2f2f4;
  }
}
