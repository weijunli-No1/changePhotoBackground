@import "../../styles/tokens.wxss";
.nav-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: #fff;
  color: var(--sg-text);
}
.nav-content {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-title {
  font-size: var(--sg-font-section);
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
  max-width: 350rpx;
}
.left-box {
  position: absolute;
  left: 12rpx;
  top: 0;
  bottom: 0;
  width: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-btn-pressed {
  opacity: 0.5;
}
@media (prefers-color-scheme: dark) {
  .nav-container {
    background: #121212;
    color: #f2f2f4;
  }
}

.nav-brand {
  display: flex;
  align-items: center;
  justify-content: center;
}
.nav-brand t-icon {
  margin-right: 10rpx;
}
.nav-inverse {
  background: #16885d;
  color: #fff;
}

.nav-logo {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
