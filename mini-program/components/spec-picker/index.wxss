@import "../../styles/tokens.wxss";
.spec-overlay {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 11000;
  display: flex;
  align-items: flex-end;
}
.spec-scrim {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(10, 25, 20, 0.34);
  opacity: 0;
}
.spec-sheet {
  position: relative;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  overflow: hidden;
  background: var(--sg-surface);
  color: var(--sg-text);
  width: 100%;
  padding: 8px var(--sg-gutter) 0;
  box-sizing: border-box;
  border-radius: var(--sg-radius-card) var(--sg-radius-card) 0 0;
  transform: translateY(100%);
}
.spec-head {
  position: relative;
  padding-top: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-shrink: 0;
  min-height: 44px;
  font-size: var(--sg-font-section);
  font-weight: 600;
}
.spec-body {
  flex-shrink: 0;
  min-height: 0;
  width: 100%;
}
.spec-body-content {
  display: flex;
  flex-direction: column;
}
.spec-head > text {
  flex: 1;
  min-width: 0;
}
.spec-close {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.spec-description {
  flex-shrink: 0;
  font-size: var(--sg-font-note);
  color: var(--sg-muted);
  line-height: 18px;
  margin: 0 0 12px;
}
.spec-options {
  justify-content: space-between;
  display: flex;
  flex-wrap: wrap;
  flex-shrink: 0;
  margin-top: 4px;
}
.spec-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 48.5%;
  min-height: 64px;
  padding: 9px 12px;
  box-sizing: border-box;
  border: 1px solid var(--sg-line);
  border-radius: var(--sg-radius-control);
  margin-bottom: 8px;
  color: var(--sg-muted);
}
.left-option {
  margin-right: 0;
}
.option-copy {
  flex: 1;
  min-width: 0;
  padding-right: 4px;
}
.spec-name {
  color: var(--sg-text);
  font-size: var(--sg-font-label);
  font-weight: 600;
  line-height: 21px;
}
.spec-note {
  color: var(--sg-muted);
  font-size: var(--sg-font-note);
  line-height: 18px;
}
.spec-option.selected {
  color: var(--sg-brand);
  border-color: var(--sg-brand);
  background: var(--sg-brand-soft);
}
.selected .spec-name {
  color: var(--sg-brand);
  font-weight: 600;
}
.custom-fields {
  flex-shrink: 0;
  margin-top: 8px;
}
.custom-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 24px;
  margin-bottom: 8px;
}
.custom-label {
  font-size: var(--sg-font-body);
  font-weight: 600;
}
.custom-hint {
  font-size: var(--sg-font-caption);
  color: var(--sg-muted);
}
.custom-row {
  display: flex;
  align-items: center;
}
.dimension-field {
  width: 0;
  flex: 1;
  min-width: 0;
  height: 44px;
  border: 1px solid transparent;
  background: var(--sg-brand-soft);
  border-radius: var(--sg-radius-control);
  display: flex;
  align-items: center;
  box-sizing: border-box;
  padding: 0 10px;
}
.dimension-field input {
  width: 0;
  flex: 1;
  min-width: 0;
  height: 44px;
  text-align: center;
  color: var(--sg-text);
  font-size: var(--sg-font-body);
}
.dimension-label,
.dimension-unit {
  flex-shrink: 0;
  font-size: var(--sg-font-note);
  color: var(--sg-muted);
}
.dimension-unit {
  font-size: var(--sg-font-caption);
}
.dimension-times {
  flex-shrink: 0;
  color: var(--sg-muted);
  font-size: var(--sg-font-body);
  margin: 0 8px;
}
.spec-footer {
  flex-shrink: 0;
  padding: 12px 0 calc(12px + env(safe-area-inset-bottom));
}
.custom-confirm {
  border-radius: var(--sg-radius-button);
  width: 100%;
  min-height: 48px;
  padding: 12px 16px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sg-brand);
  color: var(--sg-on-brand);
  font-size: var(--sg-font-label);
  font-weight: 600;
  line-height: 21px;
}
.spec-error {
  color: var(--sg-danger);
  font-size: var(--sg-font-note);
  line-height: 18px;
  margin-top: 8px;
}
.invalid-input {
  border-color: var(--sg-danger);
}
.pressed {
  opacity: 0.7;
}
.confirm-disabled {
  background: var(--sg-disabled-bg);
  color: var(--sg-disabled-text);
}
.compact-layout .spec-option {
  min-height: 48px;
  padding: 6px 10px;
}
.compact-layout .spec-name {
  font-size: var(--sg-font-body);
  line-height: 18px;
}
.compact-layout .spec-note {
  font-size: var(--sg-font-caption);
  line-height: 16px;
}
.compact-layout .spec-description {
  margin-bottom: 8px;
}
.compact-layout .custom-confirm {
  min-height: 44px;
  padding-top: 10px;
  padding-bottom: 10px;
}
.keyboard-layout .custom-fields {
  margin-top: 4px;
}
.keyboard-layout .spec-footer {
  padding: 6px 0;
}
.keyboard-layout .spec-head { padding-top: 0; }
.keyboard-layout .custom-heading { margin-bottom: 4px; }
@media (max-width: 340px) {
  .spec-option { padding-left: 6px; padding-right: 6px; }
}
.motion-fallback .spec-sheet {
  transition: transform 0.18s ease;
}
.motion-fallback .spec-scrim {
  transition: opacity 0.18s ease;
}
.motion-fallback.is-open .spec-sheet {
  transition-duration: 0.26s;
  transform: translateY(0);
}
.motion-fallback.is-open .spec-scrim {
  opacity: 1;
}
.spec-catalog-link {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--sg-brand);
  font-size: var(--sg-font-body);
  flex-shrink: 0;
}

.custom-disclosure {
  margin-top: 4px;
  padding: 0 12px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--sg-soft);
  color: var(--sg-text);
  border-radius: var(--sg-radius-control);
  font-size: var(--sg-font-body);
}
.spec-option { transition: border-color 140ms ease-out, background-color 140ms ease-out; }
@media (prefers-reduced-motion: reduce) {
  .spec-option, .motion-fallback .spec-sheet, .motion-fallback .spec-scrim { transition: none; }
}
.head-grip { position: absolute; top: 0; left: calc(50% - 26rpx); width: 52rpx; height: 6rpx; border-radius: 3rpx; background: var(--sg-line); }
.option-sample { margin-left: -6rpx; margin-right: 6rpx; }
.custom-preview {
  display: flex; align-items: center; padding: 16rpx; margin-bottom: 16rpx;
  border-radius: var(--sg-radius-control); background: var(--sg-brand-soft);
}
.preview-ratio { display: flex; align-items: center; justify-content: center; width: 108rpx; height: 102rpx; border-radius: var(--sg-radius-small); background: var(--sg-surface); }
.preview-copy { margin-left: 16rpx; flex: 1; min-width: 0; }
.preview-title { color: var(--sg-muted); font-size: var(--sg-font-note); }
.preview-value { color: var(--sg-brand); font-weight: 600; font-size: var(--sg-font-label); }
