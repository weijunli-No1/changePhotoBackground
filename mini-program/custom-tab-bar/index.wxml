<view wx:if="{{visible}}" class="tab-bar"
  ><view
    class="tab-item {{value === item.value ? 'active' : ''}}"
    wx:for="{{list}}"
    wx:key="value"
    data-value="{{item.value}}"
    bindtap="onChange"
    hover-class="tab-pressed"
    ><t-icon name="{{item.icon}}" size="44rpx" /><text>{{item.label}}</text></view
  ></view
>
