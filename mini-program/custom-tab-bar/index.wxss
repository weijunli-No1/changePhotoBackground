:host {
  display: block;
}
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 16rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e3eaf7;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  color: #5b6b82;
  font-size: 22rpx;
}
.tab-item text {
  margin-top: 4rpx;
}
.active {
  color: #2563eb;
  font-weight: 600;
}
.tab-pressed {
  opacity: 0.6;
}
@media (prefers-color-scheme: dark) {
  .tab-bar {
    background: #1c1c1e;
    border-color: #363639;
  }
  .tab-item {
    color: #ababaf;
  }
  .active {
    color: #78cbb4;
  }
}
