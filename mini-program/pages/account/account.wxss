
.account-body {
  padding: 32rpx var(--sg-gutter) 48rpx;
}
.account-title {
  font-size: var(--sg-font-title);
  font-weight: 600;
}
.account-note {
  color: var(--sg-muted);
  font-size: var(--sg-font-body);
  line-height: 1.7;
  margin-top: 14rpx;
}
.avatar-picker {
  background: transparent;
  border: 0;
  padding: 0;
  margin: 0 0 32rpx;
  width: 100%;
  color: var(--sg-brand);
  font-weight: 400;
}
.avatar-picker::after,
.primary::after {
  border: 0;
}
.account-avatar {
  display: block;
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  margin: 0;
}
.avatar-placeholder {
  background: var(--sg-soft);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  font-size: var(--sg-font-body);
}
.nickname-label {
  font-size: var(--sg-font-body);
  font-weight: 600;
  margin-bottom: 18rpx;
}
.nickname-input {
  height: 100rpx;
  border-radius: var(--sg-radius-control);
  background: var(--sg-soft);
  color: var(--sg-text);
  padding: 0 24rpx;
  font-size: var(--sg-font-body);
}
.input-note {
  font-size: var(--sg-font-note);
}
.error-inline {
  margin-top: 24rpx;
}
.account-privacy {
  margin-top: 44rpx;
  color: var(--sg-muted);
  font-size: var(--sg-font-note);
  line-height: 1.8;
}
.footer-actions {
  flex-shrink: 0;
}
.primary[disabled] {
  background: var(--sg-soft);
  color: var(--sg-muted);
}

/* form 的原生容器不参与 flex 高度分配，页面自身提供确定高度。 */
.page-wrap { height: 100vh; }
.footer-actions .primary { width: 100%; max-width: none; margin: 0; }
.account-body .avatar-picker {
  width: 100%;
  max-width: none;
  display: flex;
  flex-direction: row;
  align-items: center;
}
.account-avatar { flex-shrink: 0; }
.avatar-action { margin-left: auto; font-weight: 600; }

.account-card { margin-top: 28rpx; padding: 28rpx; background: var(--sg-surface); border: 1rpx solid var(--sg-line); border-radius: var(--sg-radius-card); }
.account-body .avatar-picker { padding-bottom: 24rpx; border-bottom: 1rpx solid var(--sg-line); border-radius: 0; }
.avatar-placeholder { background: var(--sg-brand-soft); }
.account-privacy { margin-top: 20rpx; }
