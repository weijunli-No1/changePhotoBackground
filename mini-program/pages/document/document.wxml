<view class="page-wrap theme-{{studioTheme.id}}">
  <navigation-bar title="{{title}}" show-back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y scroll-into-view="{{anchor}}" show-scrollbar="{{false}}">
    <view class="doc-body">
      <view class="doc-intro">{{introduction}}</view>
      <view class="contents">
        <view class="contents-toggle" bindtap="toggleContents" hover-class="pressed" aria-role="button" aria-expanded="{{contentsOpen}}">
          <text>文章目录</text><text class="contents-action">{{contentsOpen ? '收起' : '展开'}}</text>
        </view>
        <block wx:if="{{contentsOpen}}">
          <view wx:for="{{sections}}" wx:key="id" class="contents-link" data-anchor="{{item.id}}" bindtap="goToSection" hover-class="pressed" aria-role="button">
            <text class="doc-number">{{item.number}}</text><text>{{item.title}}</text>
          </view>
        </block>
      </view>
      <view class="doc-sections">
        <view wx:for="{{sections}}" wx:key="id" id="{{item.id}}" class="doc-section">
          <view class="doc-heading"><text class="doc-number">{{item.number}}</text><text>{{item.title}}</text></view>
          <text wx:for="{{item.paragraphs}}" wx:for-item="paragraph" wx:key="*this" class="doc-text" user-select>{{paragraph}}</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
