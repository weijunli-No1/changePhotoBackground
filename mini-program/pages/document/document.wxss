.doc-scroll {
  flex: 1;
  background-color: var(--td-bg-color-container, #ffffff);
  padding: 32rpx var(--sg-gutter);
  box-sizing: border-box;
}

.doc-text {
  font-size: var(--sg-font-body);
  line-height: 1.8;
  color: var(--sg-text);
  white-space: pre-wrap;
  display: block;
}

@media (prefers-color-scheme: dark) {
  .doc-scroll {
    background-color: var(--td-bg-color-container, #1e1e1e);
  }
  .doc-text {
    color: var(--td-text-color-secondary, #999999);
  }
}
