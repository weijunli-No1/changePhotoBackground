<view class="page-wrap editor-page">
  <navigation-bar
    title="{{toolId === 'background' ? '更换证件照底色' : '制作证件照'}}"
    show-back="{{true}}"
  />
  <view wx:if="{{sourcePath}}" class="studio-toolbar"
    ><view class="studio-caption"
      ><t-icon name="adjustment" size="32rpx" /><text>调整照片</text></view
    ><view
      class="compare-button"
      bindtap="toggleCompare"
      hover-class="pressed"
      aria-role="button"
      aria-pressed="{{comparing}}"
      aria-label="{{comparing ? '查看处理效果' : '查看原始照片'}}"
      ><t-icon name="browse" size="30rpx" /><text
        >{{comparing ? '查看效果' : '查看原图'}}</text
      ></view
    ></view
  >
  <view class="studio">
    <canvas wx:if="{{needsCanvas}}" type="2d" id="toolCanvas" class="brand-canvas"></canvas>
    <image
      wx:if="{{sourcePath}}"
      class="studio-photo"
      src="{{comparing ? sourcePath : (previewPath || sourcePath)}}"
      mode="aspectFit"
      show-menu-by-longpress="{{!comparing && !!previewPath}}"
    />
    <view wx:else class="studio-empty"
      ><t-icon name="image-add" size="64rpx" /><text
        >请选择一张正面照片</text
      ></view
    >
    <view wx:if="{{processing}}" class="processing-cover"
      ><view class="processing-dot"></view><text>{{status}}</text
      ><view
        class="processing-cancel"
        bindtap="cancelProcessing"
        aria-role="button"
        hover-class="pressed"
        >取消处理</view
      ></view
    >
  </view>
  <view class="editor-controls">
    <view
      class="size-summary"
      bindtap="showSpecs"
      hover-class="pressed"
      aria-role="button"
      aria-label="{{'更改规格，当前' + size.name + '，' + size.width + '乘' + size.height + '像素'}}"
      ><view class="size-copy"
        ><text class="size-name">{{size.name}}</text
        ><text class="size-pixels"
          >{{size.width}} × {{size.height}} px</text
        ></view
      ><view class="size-change"
        >更改规格<t-icon name="chevron-right" size="28rpx" /></view
    ></view>
    <view
      class="editor-tabs {{motionTabsReady ? 'motion-tabs' : ''}}"
      aria-role="tablist"
      ><view class="editor-indicator"></view
      ><view
        class="editor-tab {{panel !== 'adjust' ? 'active' : ''}}"
        data-panel="color"
        bindtap="setPanel"
        aria-role="tab"
        aria-selected="{{panel !== 'adjust'}}"
        >背景底色</view
      ><view
        class="editor-tab {{panel === 'adjust' ? 'active' : ''}}"
        data-panel="adjust"
        bindtap="setPanel"
        aria-role="tab"
        aria-selected="{{panel === 'adjust'}}"
        >裁剪构图</view
      ></view
    >
    <view class="panel-content">
      <view wx:if="{{panel !== 'adjust'}}" class="color-row">
        <view
          class="swatch-item"
          wx:for="{{presetColors}}"
          wx:key="value"
          data-color="{{item.value}}"
          bindtap="selectColor"
          aria-role="radio"
          aria-label="{{item.name}}"
          aria-checked="{{currentBgColor === item.value && !custom}}"
          aria-disabled="{{opening}}"
          ><view
            class="swatch {{currentBgColor === item.value && !custom ? 'selected' : ''}}"
            style="background-color:{{item.value}}"
            ><t-icon
              wx:if="{{currentBgColor === item.value && !custom}}"
              name="check"
              size="34rpx"
              color="{{item.value === '#FFFFFF' ? 'var(--sg-brand)' : '#FFFFFF'}}" /></view
          ><text
            class="swatch-name {{currentBgColor === item.value && !custom ? 'chosen' : ''}}"
            >{{item.name}}</text
          ></view
        >
        <view
          class="swatch-item"
          bindtap="showCustomColor"
          aria-role="radio"
          aria-label="自定义底色"
          aria-checked="{{custom}}"
          ><view
            class="swatch custom-swatch {{custom ? 'selected' : ''}}"
            style="background-color:{{custom ? currentBgColor : ''}}"
            ><t-icon
              name="{{custom ? 'check' : 'palette'}}"
              size="36rpx" /></view
          ><text class="swatch-name {{custom ? 'chosen' : ''}}"
            >自定义</text
          ></view
        >
      </view>
      <view wx:else class="adjust-row"
        ><view
          class="secondary adjust-button"
          bindtap="adjustPhoto"
          aria-role="button"
          ><t-icon name="cut" size="34rpx" /><text>裁剪与旋转</text></view
        ><view
          class="secondary adjust-button"
          bindtap="reselect"
          aria-role="button"
          ><t-icon name="refresh" size="34rpx" /><text>重选照片</text></view
        ></view
      >
    </view>
    <view wx:if="{{openingError}}" class="editor-error" aria-role="alert"
      >{{openingError}}</view
    >
    <view wx:if="{{error}}" class="editor-error" aria-role="alert"
      >{{error}}</view
    >
    <view wx:if="{{error}}" class="recovery-actions"
      ><view
        class="link"
        bindtap="retry"
        hover-class="pressed"
        aria-role="button"
        >{{errorRecovery === 'reselect' ? '重新选择照片' : '重试处理'}}</view
      ><view
        wx:if="{{errorRecovery !== 'reselect'}}"
        class="link"
        bindtap="reselect"
        hover-class="pressed"
        aria-role="button"
        >重新选择</view
      ></view
    >
  </view>
  <view class="footer-actions"
    ><view class="preview-watermark-note">预览含“拾光小相”水印，正常保存可获取无水印照片</view><view
      class="primary {{processing || opening || !resultPath ? 'disabled' : ''}}"
      aria-disabled="{{processing || opening || !resultPath}}"
      bindtap="goExport"
      hover-class="pressed"
      aria-role="button"
      >{{opening ? '正在准备…' : processing ? '正在处理照片…' :
      '预览并保存'}}</view
    ></view
  >
  <spec-picker
    visible="{{specVisible}}"
    current-width="{{size.width}}"
    current-height="{{size.height}}"
    bind:select="selectSpec"
    bind:close="closeSpecs"
    bind:browse="browseSpecs"
  />
  <t-color-picker
    visible="{{colorPickerVisible}}"
    use-popup="{{true}}"
    type="multiple"
    format="HEX"
    value="{{currentBgColor}}"
    bind:change="customColor"
    bind:close="closeCustomColor"
  />
</view>
