.editor-page {
  background: var(--sg-bg);
}
.studio-toolbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 8rpx 36rpx 12rpx;
  padding: 0 24rpx;
  border-radius: var(--sg-radius-card);
  background: var(--sg-canvas);
}
.studio-caption {
  min-height: 44px;
  display: flex;
  align-items: center;
  font-size: var(--sg-font-body);
  color: var(--sg-text);
}
.studio-caption text {
  margin-left: 12rpx;
}
.compare-button {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  font-size: var(--sg-font-body);
  color: var(--sg-text);
}
.compare-button text {
  margin-left: 10rpx;
}
.studio {
  flex: 1;
  min-height: 120rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 48rpx;
  margin: 0 36rpx;
  background: var(--sg-canvas);
  border-radius: 24rpx 24rpx 0 0;
  overflow: hidden;
}
.studio-photo {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}
.studio-empty {
  color: var(--sg-muted);
  display: flex;
  align-items: center;
  flex-direction: column;
  font-size: var(--sg-font-body);
}
.studio-empty text {
  margin-top: 20rpx;
}
.processing-cover {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.processing-card {
  max-width: 86%;
  padding: 32rpx;
  border-radius: var(--sg-radius-button);
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.94);
  color: #142a43;
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}
.processing-dot {
  width: 56rpx;
  height: 56rpx;
  border: 0;
  border-radius: 50%;
  margin-bottom: 20rpx;
  box-sizing: border-box;
  animation: sg-campus-spin 1s linear infinite;
}
@keyframes sg-campus-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
.processing-title {
  font-size: var(--sg-font-label);
  font-weight: 600;
}
.processing-note {
  font-size: var(--sg-font-note);
  color: #63718a;
  margin-top: 10rpx;
}
.processing-cancel {
  min-height: 44px;
  padding: 0 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--sg-brand);
  border-radius: var(--sg-radius-button);
  margin-top: 24rpx;
  color: var(--sg-brand);
  font-size: var(--sg-font-body);
}
.editor-controls {
  background: var(--sg-surface);
  padding: 0 36rpx;
  flex-shrink: 0;
}
.size-summary {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx;
  box-sizing: border-box;
  border-radius: 0 0 24rpx 24rpx;
  background: var(--sg-blue);
  color: #fff;
}
.size-copy {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
  flex-wrap: wrap;
}
.size-name {
  font-size: var(--sg-font-section);
  font-weight: 700;
  margin-right: 20rpx;
}
.size-pixels {
  color: #fff;
  font-size: var(--sg-font-note);
}
.size-change {
  display: flex;
  align-items: center;
  color: #fff;
  font-size: var(--sg-font-note);
  min-height: 44px;
}
.editor-tabs {
  position: relative;
  display: flex;
  border-bottom: 1rpx solid var(--sg-line);
  margin-top: 12rpx;
}
.editor-tab {
  flex: 1;
  min-height: 44px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  font-size: var(--sg-font-label);
  border-bottom: 6rpx solid transparent;
  color: var(--sg-muted);
}
.editor-tab.active {
  border-color: var(--sg-yellow);
  color: var(--sg-text);
  font-weight: 700;
}
.editor-indicator {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 6rpx;
  background: var(--sg-yellow);
  opacity: 0;
  border-radius: 8rpx;
}
.motion-tabs .editor-tab.active {
  border-color: transparent;
}
.panel-content {
  min-height: 148rpx;
  box-sizing: border-box;
  padding: 20rpx 0 8rpx;
  display: flex;
  align-items: center;
}
.color-row,
.adjust-row {
  display: flex;
  padding: 0;
  width: 100%;
}
.swatch-item {
  flex: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
  min-height: 112rpx;
}
.swatch {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 2rpx solid var(--sg-line);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.swatch.selected {
  border: 4rpx solid var(--sg-brand);
  box-shadow:
    0 0 0 5rpx var(--sg-surface),
    0 0 0 8rpx var(--sg-brand);
}
.custom-swatch {
  background: var(--sg-soft);
  color: var(--sg-brand);
}
.swatch-name {
  margin-top: 12rpx;
  font-size: var(--sg-font-note);
  color: var(--sg-text);
}
.swatch-name.chosen {
  color: var(--sg-brand);
  font-weight: 600;
}
.adjust-button {
  flex: 1;
  margin-right: 16rpx;
  font-size: var(--sg-font-body);
}
.adjust-button:last-child {
  margin-right: 0;
}
.adjust-button text {
  margin-left: 10rpx;
}
.editor-error {
  font-size: var(--sg-font-note);
  line-height: 1.6;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  padding: 16rpx;
}
.editor-error t-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
}
.error-title {
  font-size: var(--sg-font-body);
  font-weight: 600;
  margin-bottom: 4rpx;
}
.recovery-actions {
  margin-top: 16rpx;
}
.recovery-reselect {
  border: 1rpx solid var(--sg-brand);
  color: var(--sg-brand);
  background: var(--sg-surface);
  margin-top: 12rpx;
}
.editor-page .footer-actions {
  border-top: 0;
  padding-top: 12rpx;
}
.recovery-footer .primary {
  display: none;
}
@media (prefers-color-scheme: dark) {
  .processing-card {
    background: rgba(28, 28, 30, 0.95);
    color: #f2f2f4;
  }
  .processing-note {
    color: #ababaf;
  }
}
@media (max-height: 680px) {
  .panel-content {
    min-height: 128rpx;
    padding-top: 16rpx;
  }
  .studio-toolbar {
    margin-bottom: 8rpx;
  }
  .size-summary {
    min-height: 80rpx;
  }
}

.processing-dot {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Short, centered selection marker matching the V3 tabs. */
.editor-tab {
  position: relative;
}
.editor-tab.active {
  border-bottom-color: transparent;
}
.editor-tab.active::after {
  content: "";
  position: absolute;
  left: calc(50% - 32rpx);
  bottom: 0;
  width: 64rpx;
  height: 6rpx;
  border-radius: 8rpx;
  background: var(--sg-yellow);
}
.motion-tabs .editor-tab.active::after {
  opacity: 0;
}
