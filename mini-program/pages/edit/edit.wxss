.editor-page {
  background: var(--sg-canvas);
}
.studio-toolbar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4rpx 36rpx 12rpx;
  background: var(--sg-surface);
}
.studio-caption {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--sg-muted);
}
.studio-caption text {
  margin-left: 12rpx;
}
.compare-button {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 20rpx;
  border: 1rpx solid var(--sg-line);
  border-radius: 14rpx;
  font-size: 25rpx;
  color: var(--sg-text);
}
.compare-button text {
  margin-left: 10rpx;
}
.studio {
  flex: 1;
  min-height: 120rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 56rpx;
}
.studio-photo {
  width: 100%;
  height: 100%;
}
.studio-empty {
  color: var(--sg-muted);
  display: flex;
  align-items: center;
  flex-direction: column;
  font-size: 26rpx;
}
.studio-empty text {
  margin-top: 20rpx;
}
.processing-cover {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(239, 246, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  font-size: 26rpx;
  color: var(--sg-brand);
}
.processing-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 10rpx;
  background: currentColor;
  margin-bottom: 20rpx;
  animation: sg-pulse 1s ease-in-out infinite alternate;
}
@keyframes sg-pulse {
  from {
    opacity: 0.3;
  }
  to {
    opacity: 1;
  }
}
.processing-cancel {
  min-height: 44px;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid currentColor;
  border-radius: 14rpx;
  margin-top: 24rpx;
}
.editor-controls {
  background: var(--sg-surface);
  padding: 0 36rpx 8rpx;
  border-radius: 24rpx 24rpx 0 0;
  flex-shrink: 0;
}
.size-summary {
  min-height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid var(--sg-line);
}
.size-copy {
  display: flex;
  align-items: baseline;
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
  flex-wrap: wrap;
}
.size-name {
  font-size: 30rpx;
  font-weight: 600;
  margin-right: 16rpx;
}
.size-pixels {
  color: var(--sg-muted);
  font-size: 24rpx;
}
.size-change {
  display: flex;
  align-items: center;
  color: var(--sg-muted);
  font-size: 24rpx;
  min-height: 44px;
}
.editor-tabs {
  display: flex;
  border-bottom: 1rpx solid var(--sg-line);
}
.editor-tab {
  flex: 1;
  min-height: 44px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 4rpx solid transparent;
  color: var(--sg-muted);
}
.editor-tab.active {
  border-color: var(--sg-brand);
  color: var(--sg-brand);
  font-weight: 600;
}
.color-row {
  display: flex;
  padding: 0;
  width: 100%;
}
.swatch-item {
  flex: 1;
  display: flex;
  align-items: center;
  flex-direction: column;
  min-height: 104rpx;
}
.swatch {
  width: 72rpx;
  height: 72rpx;
  border-radius: 36rpx;
  border: 2rpx solid var(--sg-line);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.swatch.selected {
  border-color: var(--sg-brand);
  border-width: 3rpx;
}
.custom-swatch {
  background: var(--sg-soft);
  color: var(--sg-brand);
}
.swatch-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--sg-muted);
}
.swatch-name.chosen {
  color: var(--sg-brand);
  font-weight: 600;
}
.adjust-row {
  display: flex;
  padding: 0;
  width: 100%;
}
.adjust-button {
  flex: 1;
  margin-right: 16rpx;
  font-size: 25rpx;
}
.adjust-button:last-child {
  margin-right: 0;
}
.adjust-button text {
  margin-left: 10rpx;
}
.editor-error {
  font-size: 24rpx;
  color: var(--sg-danger);
  line-height: 1.6;
  margin-top: 12rpx;
}
.recovery-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.editor-page .footer-actions {
  border-top: 0;
  padding-top: 12rpx;
}
@media (prefers-color-scheme: dark) {
  .processing-cover {
    background: rgba(32, 32, 34, 0.92);
    color: #f2f2f4;
  }
}

.panel-content {
  min-height: 160rpx;
  box-sizing: border-box;
  padding: 24rpx 0 12rpx;
  display: flex;
  align-items: center;
}

.editor-tabs {
  position: relative;
}
.editor-indicator {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 4rpx;
  background: var(--sg-brand);
  opacity: 0;
}
.motion-tabs .editor-tab.active {
  border-color: transparent;
}
