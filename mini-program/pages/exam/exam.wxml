<view class="page-wrap theme-{{studioTheme.id}}">
  <navigation-bar title="考试照片适配" show-back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="exam-body">
      <block wx:if="{{spec}}">
        <view class="exam-name">{{spec.name}}</view>
        <view class="exam-subtitle">{{spec.dimensionLabel}}</view>
        <view class="exam-preview {{!sourcePath ? 'exam-preview-empty' : ''}}">
          <canvas wx:if="{{needsCanvas}}" type="2d" id="toolCanvas" class="brand-canvas"></canvas>
          <image wx:if="{{displayPath && !adjusting}}" src="{{displayPath}}" mode="aspectFit" class="exam-photo"
            style="{{cropReady ? frameStyle : ''}}" show-menu-by-longpress="{{false}}" bindtap="viewLarge" aria-role="button" aria-label="放大查看照片"/>
          <view wx:elif="{{sourcePath && cropReady}}" class="exam-crop-frame" style="{{frameStyle}}">
            <image class="exam-original" src="{{sourcePath}}" mode="scaleToFill" style="{{imageStyle}}{{positionStyle}}" show-menu-by-longpress="{{false}}" />
            <view wx:if="{{adjusting}}" class="exam-guides"><view class="guide-cols"></view><view class="guide-rows"></view></view>
          </view>
          <image wx:elif="{{sourcePath}}" src="{{sourcePath}}" mode="aspectFit" class="exam-photo" show-menu-by-longpress="{{false}}"/>
          <view wx:else class="exam-empty" bindtap="choosePhoto" hover-class="pressed" aria-role="button" aria-label="选择符合要求的正面原照">
            <view class="exam-sample" style="width:{{spec.width / spec.height * 210}}rpx;">
              <t-icon name="user-filled" size="150rpx" />
              <view class="exam-guides"><view class="guide-cols"></view><view class="guide-rows"></view></view>
            </view>
            <text>选择正面原照</text>
          </view>
          <view wx:if="{{displayPath && !processing && !adjusting}}" class="photo-zoom" bindtap="viewLarge" hover-class="pressed" aria-role="button" aria-label="查看带水印大图">
            <t-icon name="zoom-in" size="34rpx" />
          </view>
          <view wx:if="{{processing}}" class="exam-loading" aria-role="status">
            <view class="loading-spinner"></view><text>{{proofing ? '正在制作预览…' : '正在适配尺寸与体积…'}}</text>
          </view>
        </view>
        <view wx:if="{{sourcePath}}" class="exam-toolbar">
          <view wx:if="{{resultPath}}" class="exam-summary" aria-role="status">
            <t-icon name="check-circle-filled" size="26rpx"/>
            <text>尺寸已适配 · {{resultWidth}} × {{resultHeight}} px · {{resultSize}}</text>
          </view>
          <view wx:else class="exam-summary">{{adjusting ? '构图预览' : '原图预览'}}</view>
          <view class="change-photo" bindtap="choosePhoto" aria-role="button" aria-disabled="{{processing || opening}}" hover-class="pressed">换照片</view>
        </view>
        <view wx:if="{{cropReady && (canMoveX || canMoveY)}}" class="compose-panel">
          <view class="setting-title">裁剪位置</view>
          <view wx:if="{{canMoveX}}" class="exam-slider">
            <text>左右</text>
            <slider active-color="{{studioAccent || '#4f55ce'}}" value="{{positionX}}" data-axis="X" bindchanging="move" bindchange="moveEnd"
              bindtouchcancel="cancelMove" disabled="{{processing || opening}}" min="0" max="100" block-size="20" aria-label="左右裁剪位置"/>
            <text class="slider-value">{{positionX}}%</text>
          </view>
          <view wx:if="{{canMoveY}}" class="exam-slider">
            <text>上下</text>
            <slider active-color="{{studioAccent || '#4f55ce'}}" value="{{positionY}}" data-axis="Y" bindchanging="move" bindchange="moveEnd"
              bindtouchcancel="cancelMove" disabled="{{processing || opening}}" min="0" max="100" block-size="20" aria-label="上下裁剪位置"/>
            <text class="slider-value">{{positionY}}%</text>
          </view>
        </view>
        <view class="exam-rules">
          <view class="rules-heading">
            <text class="setting-title">照片要求</text>
            <view wx:if="{{sourcePath}}" class="rules-action" bindtap="smartPhoto" aria-role="button" aria-disabled="{{processing || opening}}" hover-class="pressed">
              <text>智能换底色</text><t-icon name="chevron-right" size="26rpx"/>
            </view>
          </view>
          <view class="rule"><text>底色</text><text>{{spec.background}}</text></view>
          <view class="rule"><text>文件</text><text>{{spec.format}} · {{spec.fileRule}}</text></view>
        </view>
        <view class="exam-note">提交前请核对底色与报名要求。</view>
      </block>
      <view wx:else class="empty-state">
        <view class="empty-title">暂时无法使用这个规格</view>
        <view class="secondary" bindtap="openSpecs" hover-class="pressed" aria-role="button">重新选择规格</view>
      </view>
      <view wx:if="{{error && (!spec || !sourcePath)}}" class="error-inline" aria-role="alert">{{error}}</view>
    </view>
  </scroll-view>
  <view wx:if="{{spec && sourcePath}}" class="footer-actions">
    <view wx:if="{{error}}" class="error-inline" aria-role="alert">{{error}}</view>
    <view wx:if="{{error && !resultPath && !processing}}" class="primary" bindtap="process" hover-class="pressed" aria-role="button">重新适配</view>
    <view wx:else class="primary {{processing || opening || adjusting || !resultPath ? 'disabled' : ''}}" bindtap="goExport" hover-class="pressed"
      aria-role="button" aria-disabled="{{processing || opening || adjusting || !resultPath}}">
      {{processing ? '正在适配…' : opening ? '正在准备…' : '预览并保存'}}
    </view>
  </view>
  <view wx:elif="{{spec}}" class="footer-actions"><view class="primary" bindtap="choosePhoto" hover-class="pressed" aria-role="button">选择原照</view></view>
</view>
