.export-body { padding: 14rpx var(--sg-gutter) 32rpx; }
.export-heading { display: flex; align-items: center; min-height: 58rpx; margin-bottom: 22rpx; font-size: var(--sg-font-title); font-weight: 700; line-height: 1.25; }
.export-heading > t-icon, .sample-tag { margin-left: 16rpx; }
.sample-tag { padding: 4rpx 13rpx; border-radius: 9rpx; background: #f5dfb3; color: #62441c; font-size: var(--sg-font-caption); font-weight: 600; line-height: 1.5; }
.export-options { display: flex; background: var(--sg-soft); border: 1rpx solid var(--sg-line); border-radius: var(--sg-radius-button); padding: 6rpx; margin-bottom: 22rpx; }
.export-option { flex: 1; min-width: 0; min-height: 44px; padding: 0 12rpx; border-radius: var(--sg-radius-control); display: flex; align-items: center; justify-content: center; font-size: var(--sg-font-body); font-weight: 600; color: var(--sg-muted); box-sizing: border-box; }
.export-option t-icon { margin-right: 12rpx; }
.export-option.selected { background: var(--sg-brand); color: var(--sg-on-brand); }
.export-option.option-unavailable { opacity: .5; }
.export-preview { box-sizing: border-box; overflow: hidden; border: 1rpx solid var(--sg-line); border-radius: var(--sg-radius-card); }
.single-preview { display: flex; align-items: center; justify-content: center; height: 442rpx; padding: 34rpx; background: var(--sg-canvas); }
.export-photo { width: 100%; height: 100%; }
.portrait-preview { max-width: 272rpx; background: #fff; border: 8rpx solid #fff; box-shadow: 0 5rpx 16rpx rgba(33, 40, 34, .14); }
.print-preview { background: var(--sg-surface); }
.print-desk { display: flex; justify-content: center; align-items: flex-start; padding: 28rpx 0 28rpx; background: #e6e6f1; background-image: linear-gradient(150deg, #f1f2fc, #d9dcec); overflow: hidden; }
.printer-assembly { position: relative; width: 586rpx; height: 454rpx; flex-shrink: 0; }
.print-machine { position: absolute; left: 0; top: 0; width: 100%; height: 195rpx; }
.machine-body { width: 100%; height: 100%; display: block; }
.backup-machine { width: 100%; height: 100%; border-radius: 32rpx; background: #253c34; border-top: 45rpx solid #e8dfca; box-sizing: border-box; }
.backup-lamp { position: absolute; right: 60rpx; top: 19rpx; width: 16rpx; height: 8rpx; border-radius: 5rpx; background: #bb832b; }
.backup-slot { position: absolute; top: 138rpx; left: 60rpx; right: 60rpx; height: 17rpx; background: #121d19; border: 2rpx solid #111b16; border-radius: 8rpx; }
.paper-tray { position: absolute; top: 152rpx; left: 61rpx; width: 464rpx; height: 332rpx; overflow: hidden; }
.proof-paper, .printed-paper { position: absolute; left: 13rpx; width: 438rpx; height: 294rpx; box-sizing: border-box; background: #fff; border: 1rpx solid #d8d6cb; box-shadow: 0 6rpx 12rpx rgba(36, 39, 26, .18); }
.proof-cell { position: absolute; display: block; }
.print-caption { display: flex; align-items: center; justify-content: space-between; padding: 19rpx 24rpx; border-top: 1rpx solid var(--sg-line); }
.caption-copy { flex: 1; min-width: 0; }
.caption-title { font-size: var(--sg-font-label); font-weight: 650; }
.caption-note { display: flex; align-items: center; margin-top: 3rpx; font-size: var(--sg-font-note); color: var(--sg-muted); }
.status-lamp { width: 10rpx; height: 10rpx; flex-shrink: 0; border-radius: 50%; margin-right: 10rpx; background: var(--sg-green-ink); }
.lamp-working { background: #be7b18; }
.replay { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 19rpx; margin-left: 12rpx; border-radius: var(--sg-radius-control); background: var(--sg-soft); color: var(--sg-brand); font-weight: 600; font-size: var(--sg-font-note); }
.replay t-icon { margin-right: 8rpx; }
.replay-pending { color: var(--sg-muted); }
.print-preview > .stage-message { min-height: 390rpx; }
.stage-message { display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--sg-muted); font-size: var(--sg-font-note); }
.stage-message > t-icon, .stage-message .loading-spinner { margin-bottom: 12rpx; }
.retry-sample { padding: 16rpx; color: var(--sg-green-ink); }
.photo-meta { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--sg-line); }
.meta-item { margin-right: 8rpx; font-size: var(--sg-font-body); font-weight: 600; }
.meta-label { display: block; margin-bottom: 3rpx; color: var(--sg-muted); font-size: var(--sg-font-caption); font-weight: 400; }
.paper-info { display: flex; align-items: flex-start; margin: 22rpx 0 0; line-height: 1.6; color: var(--sg-muted); font-size: var(--sg-font-note); }
.paper-info t-icon { flex-shrink: 0; margin: 4rpx 12rpx 0 0; color: var(--sg-green-ink); }
.usage-note, .export-note, .saved-detail { margin-top: 13rpx; color: var(--sg-muted); font-size: var(--sg-font-note); line-height: 1.6; }
.usage-note, .saved-detail { color: var(--sg-green-ink); }
.footer-actions { flex-shrink: 0; }
.footer-actions .save-error { margin: 0 0 14rpx; }
.secondary-actions { display: flex; justify-content: center; }
.return-edit, .save-again { min-height: 44px; display: flex; align-items: center; justify-content: center; padding: 0 22rpx; font-size: var(--sg-font-note); }
.return-edit { color: var(--sg-brand); }
.save-again { color: var(--sg-muted); }
.sheet-handle { width: 64rpx; height: 7rpx; border-radius: 8rpx; background: var(--sg-line); margin: 0 auto 32rpx; }
.quota-title { font-size: var(--sg-font-section); font-weight: 600; text-align: center; }
.quota-desc { font-size: var(--sg-font-body); color: var(--sg-muted); text-align: center; margin: 16rpx 0 30rpx; }
.member-save-link { padding: 24rpx 0; color: var(--sg-brand); font-size: var(--sg-font-body); text-align: center; }

.sound-control { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 12rpx; color: var(--sg-brand); font-size: var(--sg-font-note); }
.sound-control t-icon { margin-right: 5rpx; }
.printer-themes { margin-top: 18rpx; }

.desk-peach { background: #ebdfd7; background-image: linear-gradient(150deg, #fcf1e9, #e4d5cd); }
.desk-mint { background: #deeae1; background-image: linear-gradient(150deg, #edf6ee, #d6e5dc); }
.printer-sky { height: 428rpx; }
.printer-sky .print-machine { height: 162rpx; }
.printer-sky .paper-tray { top: 129rpx; }
.printer-sky .backup-machine { background: #b9d6f4; border-radius: 5rpx; border-top: 30rpx solid #79a5df; border-bottom: 6rpx solid #547eb6; }
.printer-sky .backup-slot { top: 118rpx; height: 15rpx; border-radius: 2rpx; }
.printer-peach .print-machine, .printer-mint .print-machine { height: 191rpx; }
.printer-peach .paper-tray { top: 143rpx; }
.printer-mint .paper-tray { top: 151rpx; }
