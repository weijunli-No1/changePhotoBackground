.export-body {
  padding: 16rpx 36rpx 24rpx;
}
.export-preview {
  height: 480rpx;
  border-radius: var(--sg-radius-card);
  background: var(--sg-canvas);
  padding: 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.export-photo {
  width: 100%;
  height: 100%;
}
.export-spec {
  margin: 12rpx 0 4rpx;
  text-align: center;
  font-size: var(--sg-font-section);
  font-weight: 600;
}
.export-dimensions {
  font-size: var(--sg-font-note);
  color: var(--sg-muted);
  text-align: center;
  line-height: 1.7;
}
.format-title {
  font-size: var(--sg-font-section);
  font-weight: 600;
  margin: 20rpx 0 16rpx;
}
.export-option {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  border: 2rpx solid var(--sg-line);
  border-radius: var(--sg-radius-control);
  margin-bottom: 16rpx;
  min-height: 112rpx;
  box-sizing: border-box;
}
.export-option.selected {
  border-color: var(--sg-brand);
  background: var(--sg-brand-soft);
}
.format-copy {
  flex: 1;
  padding: 0 20rpx;
  min-width: 0;
}
.format-name {
  font-size: var(--sg-font-label);
  font-weight: 600;
}
.format-note {
  margin-top: 8rpx;
  color: var(--sg-muted);
  font-size: var(--sg-font-note);
}
.single-thumb {
  width: 72rpx;
  height: 96rpx;
  flex-shrink: 0;
}
.layout-thumb {
  width: 92rpx;
  height: 74rpx;
  flex-shrink: 0;
  background: #fff;
  display: flex;
  flex-wrap: wrap;
  align-content: center;
  padding: 4rpx;
  box-sizing: border-box;
}
.layout-thumb image {
  width: 26rpx;
  height: 30rpx;
  margin: 1rpx;
}
.usage-note,
.export-note {
  font-size: var(--sg-font-note);
  line-height: 1.7;
  color: var(--sg-muted);
  margin-top: 20rpx;
}
.local-note {
  text-align: center;
  margin-top: 24rpx;
}
.export-login-hint {
  text-align: center;
  font-size: var(--sg-font-caption);
  color: var(--sg-muted);
  margin-top: 16rpx;
}
.success-note {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}
.success-note t-icon {
  margin-right: 16rpx;
  flex-shrink: 0;
}
.saved-title {
  font-size: var(--sg-font-body);
  font-weight: 600;
}
.saved-detail {
  font-size: var(--sg-font-note);
  margin-top: 8rpx;
}
.error-inline {
  margin-top: 24rpx;
}
.footer-actions {
  flex-shrink: 0;
}
.footer-actions .save-error {
  margin: 0 0 16rpx;
}
.footer-actions .loading-spinner {
  margin-right: 16rpx;
}
.save-again {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  font-size: var(--sg-font-body);
  color: var(--sg-muted);
}
.sheet-handle {
  width: 64rpx;
  height: 7rpx;
  border-radius: var(--sg-radius-small);
  background: var(--sg-line);
  margin: 0 auto 32rpx;
}
.quota-title {
  font-size: var(--sg-font-section);
  font-weight: 600;
  text-align: center;
}
.quota-desc {
  font-size: var(--sg-font-body);
  color: var(--sg-muted);
  text-align: center;
  margin: 16rpx 0 30rpx;
}

.member-save-link {
  padding: 24rpx 0;
  color: var(--sg-brand);
  font-size: var(--sg-font-body);
  text-align: center;
}

.export-heading {
  position: relative;
  display: flex;
  align-items: center;
  font-size: var(--sg-font-title);
  font-weight: 700;
  line-height: 1.4;
  padding: 8rpx 0 22rpx;
  margin-bottom: 16rpx;
}
.export-heading::after {
  content: "";
  position: absolute;
  bottom: 6rpx;
  left: 8rpx;
  width: 80rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: var(--sg-green);
  transform: rotate(-7deg);
}
.export-preview .portrait-preview {
  width: 280rpx;
  max-width: 100%;
  box-sizing: border-box;
}
.usage-note {
  background: var(--sg-green-soft);
  color: var(--sg-green);
  padding: 12rpx 18rpx;
  border-radius: var(--sg-radius-control);
  text-align: center;
  margin-top: 16rpx;
}
.export-body .preview-watermark-note {
  margin-top: 14rpx;
}
.success-note {
  color: var(--sg-green);
  background: transparent;
  align-items: flex-start;
  padding: 24rpx 0;
}
.success-note t-icon {
  font-size: var(--sg-font-metric);
}
.saved-title {
  font-size: var(--sg-font-section);
  font-weight: 700;
  color: var(--sg-text);
}
.saved-detail {
  color: var(--sg-text);
  font-size: var(--sg-font-body);
}
.return-edit {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  font-size: var(--sg-font-body);
  color: var(--sg-brand);
}
.save-again {
  margin-top: 0;
}
@media (prefers-color-scheme: dark) {
  .usage-note,
  .success-note {
    color: #92dfbb;
  }
}
@media (max-height: 740px) {
  .export-preview {
    height: 380rpx;
  }
}

.success-icon {
  color: var(--sg-green-ink);
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
}
