.works-title {
  font-size: var(--sg-font-display);
  font-weight: 700;
  margin: 4rpx 0 0;
}
.works-helper {
  font-size: var(--sg-font-note);
  color: var(--sg-muted);
  margin: 24rpx 0;
  line-height: 1.7;
}
.works-notice {
  margin-top: 24rpx;
}
.refresh-error {
  padding: 12rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: var(--sg-radius-control);
  background: var(--sg-soft);
  color: var(--sg-text);
  font-size: var(--sg-font-body);
}
.retry-link {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  color: var(--sg-brand);
  font-weight: 600;
}
.delete-target {
  width: 44px;
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--sg-danger);
}
.cloud-list {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}
.cloud-work {
  width: 48.5%;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--sg-line);
  box-sizing: border-box;
  border-radius: var(--sg-radius-card);
  background: var(--sg-surface);
  overflow: hidden;
}
.cloud-photo { width: 100%; height: 258rpx; position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--sg-canvas); }
.cloud-cover-photo, .cloud-cover-mat { width: 100%; height: 194rpx; }
.cloud-cover-mat, .cloud-cover-sheet, .view-cloud { display: flex; align-items: center; justify-content: center; }
.cloud-cover-mount { position: relative; padding: 8rpx 8rpx 18rpx; background: var(--sg-surface); border: 1rpx solid var(--sg-line); transform: rotate(-5deg); }
.cloud-cover-sheet { width: 78rpx; height: 94rpx; background: var(--sg-soft); color: var(--sg-muted); }
.cover-swatch { position: absolute; width: 18rpx; height: 6rpx; left: 8rpx; bottom: 6rpx; border: 1rpx solid var(--sg-line); }
.view-cloud { color: var(--sg-brand); font-size: var(--sg-font-note); }
.cloud-save-area {
  padding: 0 16rpx 20rpx;
}
.cloud-save {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  border-radius: var(--sg-radius-button);
  background: var(--sg-brand);
  color: var(--sg-on-brand);
  text-align: center;
  font-size: var(--sg-font-note);
  font-weight: 600;
}
.cloud-save-error,
.cloud-save-message {
  font-size: var(--sg-font-note);
  line-height: 1.6;
  margin-top: 12rpx;
}
.cloud-save-error {
  color: var(--sg-danger);
}
.cloud-save-message {
  color: var(--sg-muted);
}
.cloud-save-link {
  display: flex;
  align-items: center;
  min-height: 44px;
  font-size: var(--sg-font-note);
  color: var(--sg-brand);
}
.cloud-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 18rpx;
  font-size: var(--sg-font-caption);
  color: var(--sg-muted);
}
.cloud-meta .delete-target {
  width: 44px;
  min-width: 44px;
  min-height: 44px;
}

.segment { position: relative; padding: 5rpx; border-radius: var(--sg-radius-control); background: var(--sg-soft); }
.segment-item {
  position: relative; z-index: 1; padding: 0 10rpx; min-height: 44px; display: flex; align-items: center; justify-content: center;
  color: var(--sg-muted); border-radius: var(--sg-radius-small);
}
.segment-item.active { color: var(--sg-brand); background: var(--sg-surface); }
.works-indicator { pointer-events: none; position: absolute; left: 0; bottom: 6rpx; height: 4rpx; background: var(--sg-brand); opacity: 0; z-index: 2; border-radius: 4rpx; }
.works-heading, .album-tools, .work-bottom, .cloud-loading {
  display: flex;
  align-items: center;
}
.works-heading {
  justify-content: space-between;
  margin: 8rpx 0 24rpx;
}
.new-work, .album-manage, .album-clear {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  box-sizing: border-box;
  padding: 0 20rpx;
  border-radius: var(--sg-radius-button);
  font-size: var(--sg-font-note);
  color: var(--sg-brand);
  font-weight: 600;
}
.new-work { background: var(--sg-brand-soft); }
.new-work t-icon { margin-right: 6rpx; }
.album-tools { margin: 12rpx 0; }
.album-tools .works-helper { flex: 1; margin: 0; }
.album-clear { color: var(--sg-danger); font-weight: 400; }
.draft-album {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
}
.draft-work {
  width: 48.5%;
  margin-bottom: 20rpx;
  padding: 8rpx;
  box-sizing: border-box;
  border: 1px solid var(--sg-line);
  border-radius: var(--sg-radius-card);
  background: var(--sg-surface);
}
.draft-card { border-radius: var(--sg-radius-small); }
.proof-mount {
  height: 218rpx;
  padding: 12rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--sg-radius-small);
  background: var(--sg-soft);
}
.work-thumb { width: 100%; height: 100%; }
.thumb-fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--sg-muted);
  font-size: var(--sg-font-caption);
}
.thumb-fallback text { margin-top: 8rpx; }
.work-copy { padding: 16rpx 10rpx 8rpx; }
.work-name {
  font-size: var(--sg-font-body);
  color: var(--sg-text);
  font-weight: 600;
}
.draft-size, .work-bottom { font-size: var(--sg-font-caption); color: var(--sg-muted); }
.draft-size { margin-top: 4rpx; }
.work-bottom { justify-content: space-between; margin-top: 6rpx; min-height: 38rpx; }
.work-bottom t-icon { color: var(--sg-brand); }
.album-remove {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  margin-top: 6rpx;
  border-top: 1rpx solid var(--sg-line);
  color: var(--sg-danger);
  font-size: var(--sg-font-note);
}
.album-remove text { margin-left: 8rpx; }
.album-pressed { opacity: 0.82; }
.album-empty, .cloud-empty {
  margin-top: 22rpx; padding: 48rpx 26rpx 30rpx; background: var(--sg-surface); border: 1rpx solid var(--sg-line); border-radius: var(--sg-radius-card);
}
.album-empty .empty-desc, .cloud-empty .empty-desc { font-size: var(--sg-font-note); margin: 10rpx 0 28rpx; }
.empty-prints { position: relative; width: 240rpx; height: 188rpx; margin: 0 auto 30rpx; }
.folder-back {
  position: absolute; left: 22rpx; bottom: 4rpx; width: 194rpx; height: 110rpx; background: var(--sg-hero-control); border-radius: 10rpx;
}
.folder-tab { position: absolute; left: 0; top: -12rpx; width: 78rpx; height: 24rpx; background: var(--sg-hero-control); border-radius: 8rpx; }
.empty-back, .empty-front { position: absolute; box-sizing: border-box; border: 1px solid var(--sg-line); background: #fffdf7; border-radius: 3rpx; }
.empty-back { width: 82rpx; height: 108rpx; left: 51rpx; top: 40rpx; transform: rotate(-13deg); }
.empty-front { width: 96rpx; height: 122rpx; left: 112rpx; top: 16rpx; transform: rotate(9deg); padding: 6rpx 6rpx 15rpx; }
.empty-portrait { height: 100%; display: flex; align-items: center; justify-content: center; color: var(--sg-brand); background: var(--sg-brand-soft); }
.folder-pocket {
  position: absolute; left: 18rpx; right: 18rpx; bottom: 1rpx; height: 82rpx; border-radius: 8rpx 8rpx 16rpx 16rpx;
  background: var(--sg-hero-bg); box-shadow: 0 5rpx 12rpx rgba(38, 63, 45, .14);
}
.pocket-label { width: 56rpx; height: 10rpx; margin: 16rpx 0 0 14rpx; border-radius: 3rpx; background: var(--sg-hero-cta); }
.cloud-helper { margin: 20rpx 0 16rpx; padding: 12rpx 16rpx; background: var(--sg-brand-soft); border-radius: var(--sg-radius-control); }
.cloud-loading { min-height: 180rpx; justify-content: center; color: var(--sg-muted); font-size: var(--sg-font-note); }
.cloud-loading .loading-spinner { color: var(--sg-brand); margin-right: 14rpx; }
@media (prefers-reduced-motion: no-preference) {
  .draft-card { transition: transform 120ms ease-out, opacity 120ms; }
  .album-pressed { transform: scale(0.98); }
  .album-remove { animation: album-tools-in 140ms ease-out; }
}
@keyframes album-tools-in {
  from { opacity: 0; transform: translateY(-5rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.cloud-save.disabled { background: var(--sg-disabled-bg); color: var(--sg-disabled-text); }
.delete-target[aria-disabled="true"] { color: var(--sg-disabled-text); }
