.works-title {
  font-size: 38rpx;
  font-weight: 600;
  margin: 4rpx 0 32rpx;
}
.works-helper {
  font-size: 24rpx;
  color: var(--sg-muted);
  margin: 24rpx 0;
  line-height: 1.7;
}
.works-notice {
  margin-top: 24rpx;
}
.refresh-error {
  padding: 12rpx 24rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: var(--sg-soft);
  color: var(--sg-text);
  font-size: 26rpx;
}
.retry-link {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  color: var(--sg-brand);
  font-weight: 600;
}
.draft-work {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--sg-line);
}
.work-thumb {
  width: 116rpx;
  height: 154rpx;
  background: var(--sg-soft);
  border-radius: 12rpx;
  margin-right: 24rpx;
}
.work-copy {
  flex: 1;
}
.work-name {
  font-size: 29rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}
.resume-label {
  font-size: 24rpx;
  color: var(--sg-brand);
  margin-top: 16rpx;
}
.delete-target {
  width: 44px;
  min-width: 44px;
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--sg-muted);
}
.cloud-list {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -10rpx;
}
.cloud-work {
  width: calc(50% - 20rpx);
  margin: 0 10rpx 24rpx;
  border-radius: 18rpx;
  background: var(--sg-soft);
  overflow: hidden;
}
.cloud-photo {
  width: 100%;
  height: 330rpx;
}
.cloud-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 18rpx;
  font-size: 21rpx;
  color: var(--sg-muted);
}
.cloud-meta .delete-target {
  width: 44px;
  min-width: 44px;
  min-height: 44px;
}

.drafts-helper {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.drafts-helper .works-helper {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}
.clear-drafts {
  min-height: 44px;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: var(--sg-muted);
}
.draft-updated {
  font-size: 22rpx;
  color: var(--sg-muted);
  margin-top: 8rpx;
}
