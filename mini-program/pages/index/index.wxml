<view class="page-wrap home-page">
  <navigation-bar title="拾光小相" />
  <scroll-view class="page-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="home-body">
      <view class="home-title">今天想处理什么？</view>
      <view
        class="home-search"
        bindtap="openLibrary"
        data-search="1"
        aria-role="button"
        aria-label="搜索全部工具"
        hover-class="pressed"
        ><t-icon name="search" size="40rpx" /><text
          >搜索工具，例如：压缩</text
        ></view
      >
      <view wx:if="{{featuredTool}}" class="feature">
        <view class="feature-copy"
          ><view class="feature-title">{{featuredTool.featured.title}}</view
          ><view class="feature-note"
            >{{featuredTool.featured.description}}</view
          ><view
            class="feature-button"
            bindtap="openToolEntry"
            data-id="{{featuredTool.id}}"
            hover-class="pressed"
            aria-role="button"
            >{{featuredTool.featured.action}}</view
          ></view
        >
        <image
          wx:if="{{featuredTool.featured.image}}"
          src="{{featuredTool.featured.image}}"
          class="feature-photo"
          mode="aspectFill"
          aria-hidden="{{true}}"
        />
      </view>
      <view
        wx:if="{{entryError}}"
        class="error-inline home-error"
        aria-role="alert"
        >{{entryError}}</view
      >
      <view class="section-head"
        ><view class="section-title">常用工具</view
        ><view
          class="section-action"
          bindtap="openLibrary"
          hover-class="pressed"
          aria-role="button"
          >全部工具<t-icon name="chevron-right" size="28rpx" /></view
      ></view>
      <view class="quick-tools">
        <view
          wx:for="{{quickTools}}"
          wx:key="id"
          class="quick-item"
          data-id="{{item.id}}"
          bindtap="openToolEntry"
          hover-class="pressed"
          aria-role="button"
          aria-label="{{item.name}}"
          ><tool-glyph name="{{item.icon}}" size="{{48}}" /><text
            >{{item.name}}</text
          ></view
        >
      </view>
      <view class="section-head continue-head"
        ><view class="section-title">继续编辑</view
        ><view
          class="section-action"
          bindtap="showWorks"
          hover-class="pressed"
          aria-role="button"
          >查看作品<t-icon name="chevron-right" size="28rpx" /></view
      ></view>
      <view
        wx:if="{{draft}}"
        class="draft-row"
        bindtap="resumeDraft"
        hover-class="pressed"
        aria-role="button"
        aria-label="{{'继续编辑' + draft.title}}"
      >
        <image
          src="{{draft.resultPath || draft.sourcePath}}"
          class="draft-thumb"
          mode="aspectFill"
        /><view class="draft-copy"
          ><view class="draft-title">{{draft.title}}</view
          ><view class="draft-note">{{draft.sizeName || '保存在当前设备'}}</view
          ><view class="draft-note">{{draft.updatedLabel}}</view></view
        ><t-icon name="chevron-right" size="32rpx" />
      </view>
      <view wx:else class="draft-empty"
        ><view class="empty-draft-icon"
          ><t-icon name="folder-open" size="42rpx" /></view
        ><view
          ><view class="empty-draft-title">还没有未完成的作品</view
          ><view class="draft-note">开始处理后，会自动保留草稿</view></view
        ></view
      >
    </view>
  </scroll-view>
  <spec-picker
    visible="{{specVisible}}"
    title="{{specTitle}}"
    description="照片将上传至云端，请选择清晰的正面照。"
    current-width="{{size.width}}"
    current-height="{{size.height}}"
    bind:select="selectSpec"
    bind:close="closeSpecs"
  />
</view>
