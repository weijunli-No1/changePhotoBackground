<import src="../../templates/studio-tabs.wxml" />
<view class="page-wrap theme-{{studioTheme.id}} home-page">
  <navigation-bar title="拾光小相" brand="{{true}}" />
  <scroll-view class="page-scroll" scroll-y bindscroll="sampleScrolled" show-scrollbar="{{false}}">
    <view class="home-body">
      <view class="home-search" bindtap="openLibrary" data-search="1"
        aria-role="button" aria-label="搜索全部工具" hover-class="pressed">
        <t-icon name="search" size="36rpx" /><text>搜索照片工具</text>
        <t-icon name="chevron-right" size="28rpx" />
      </view>
      <view wx:if="{{featuredTool}}" class="feature">
        <view class="feature-main">
          <view class="feature-copy">
            <view class="feature-title">制作证件照</view>
            <view class="feature-note">照片将上传云端制作</view>
            <view class="feature-options" aria-role="radiogroup" aria-label="常用照片规格">
              <view wx:for="{{homeSizes}}" wx:key="name" id="home-size-{{item.width}}"
                class="feature-option {{size.width === item.width && size.height === item.height ? 'selected' : ''}}"
                data-index="{{index}}" bindtap="selectHomeSize" hover-class="pressed"
                aria-role="radio" aria-checked="{{size.width === item.width && size.height === item.height}}">{{item.name}}</view>
            </view>
            <view class="feature-size" data-id="{{featuredTool.id}}" bindtap="openToolEntry"
              hover-class="pressed" aria-role="button" aria-label="查看更多规格或自定义尺寸">
              更多规格<t-icon name="chevron-right" size="26rpx" />
            </view>
          </view>
          <view class="feature-proof {{sampleReduced ? 'motion-quiet' : ''}}">
            <view class="sample-motion-preference" aria-hidden="{{true}}"></view>
            <view wx:for="{{featuredTool.featured.photos}}" wx:key="id" id="sample-{{item.id}}"
              style="{{sampleStyles ? sampleStyles[item.id] : ''}}" class="sample-print {{sampleStyles ? 'sample-in-motion' : ''}} {{frontSample === item.id ? 'photo-front' : 'photo-back'}} {{frontSample === item.id && size.width === 413 ? 'large-print' : ''}}"
              data-id="{{item.id}}" bindtap="selectSample" aria-role="button"
              aria-label="{{frontSample === item.id ? '切换到另一张样片' : item.id === 'male' ? '将男生样片移到前面' : '将女生样片移到前面'}}">
              <image src="{{item.src}}" mode="aspectFill" data-id="{{item.id}}" bindload="sampleLoaded" binderror="sampleFailed" />
              <view class="proof-caption"><t-icon wx:if="{{frontSample === item.id}}" name="swap" size="20rpx" />{{size.width}} × {{size.height}} px</view>
            </view>
          </view>
        </view>
        <view class="feature-button {{pickingHome ? 'working' : ''}}" bindtap="startHomePhoto" aria-disabled="{{pickingHome}}" hover-class="photo-pressed"
          aria-role="button" aria-label="{{'选择照片制作' + size.name + '证件照'}}">
          <text>{{pickingHome ? '正在打开照片…' : '选择自己的照片'}}</text><t-icon wx:if="{{!pickingHome}}" name="arrow-right" size="34rpx" />
        </view>
      </view>
      <view class="print-entry" bindtap="openPrintDemo" hover-class="photo-pressed" aria-role="button"
        aria-label="体验六寸相纸出纸动效，使用示例照片">
        <view class="mini-printer" aria-hidden="{{true}}">
          <image class="mini-housing" src="{{studioTheme.printer || '/assets/printers/sky-matte.png'}}" mode="aspectFit" />
          <view class="mini-print">
            <image wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this" src="/assets/images/sample-female-smile.jpg" mode="aspectFill" />
          </view>
        </view>
        <view class="print-copy"><view class="print-title">六寸相纸</view>
          <view class="print-note">样片预览</view>
        </view>
        <view class="print-action">看出纸<t-icon name="arrow-right" size="27rpx" /></view>
      </view>
      <view wx:if="{{entryError}}" class="error-inline home-error" aria-role="alert"
        >{{entryError}}</view
      >
      <block wx:if="{{draft}}">
      <view class="section-head continue-head"
        ><view class="section-title">继续编辑</view
        ><view
          class="section-action"
          bindtap="showWorks"
          hover-class="pressed"
          aria-role="button"
          >查看作品<t-icon name="chevron-right" size="28rpx" /></view
      ></view>
      <view
        class="draft-row"
        bindtap="resumeDraft"
        hover-class="pressed"
        aria-role="button"
        aria-label="{{'继续编辑' + draft.title}}"
      >
        <image
          wx:if="{{!draft.thumbnailMissing}}"
          src="{{draft.displayPath}}"
          class="draft-thumb"
          mode="aspectFill"
          data-id="{{draft.id}}"
          binderror="draftImageError"
        /><view wx:else class="draft-thumb thumb-fallback" aria-hidden="{{true}}"
          ><t-icon name="image" size="40rpx"
        /></view>
        <view class="draft-copy"
          ><view class="draft-title">{{draft.title}}</view
          ><view wx:if="{{draft.sizeName}}" class="draft-note">{{draft.sizeName}}</view
          ><view class="draft-note">{{draft.updatedLabel}}</view></view
        ><view class="draft-resume"
          >继续<t-icon name="chevron-right" size="26rpx"
        /></view>
      </view>
      </block>
      <view class="section-head"
        ><view class="section-title">常用工具</view
        ><view
          class="section-action"
          bindtap="openLibrary"
          hover-class="pressed"
          aria-role="button"
          >全部工具<t-icon name="chevron-right" size="28rpx" /></view
      ></view>
      <view class="quick-tools"
        ><view
          wx:for="{{quickTools}}"
          wx:key="id"
          class="quick-item"
          data-id="{{item.id}}"
          bindtap="openToolEntry"
          hover-class="pressed"
          aria-role="button"
          aria-label="{{item.name}}"
          ><view class="quick-icon tone-{{item.tone}}"><tool-glyph name="{{item.icon}}" size="{{44}}" /></view><text
            >{{item.name}}</text
          ></view
        ></view
      >
      <view
        wx:if="{{examTool}}"
        class="exam-entry"
        data-id="{{examTool.id}}"
        bindtap="openToolEntry"
        aria-role="button"
        hover-class="pressed"
        ><view class="exam-icon"><tool-glyph name="education" size="{{44}}" /></view><view class="exam-copy"
          ><view class="exam-title">考试报名照</view
          ></view
        ><view class="exam-arrow"><t-icon name="chevron-right" size="34rpx" /></view
      ></view>
      <member-ad placement="home" bind:layoutchange="sampleLayout" />
    </view>
  </scroll-view>
  <template is="studio-tabs" data="{{current: 'index'}}" />
</view>
