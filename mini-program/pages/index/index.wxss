.home-body {
  padding: 28rpx 40rpx 40rpx;
}
.home-title {
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.4;
  margin-bottom: 24rpx;
}
.home-search {
  min-height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: var(--sg-soft);
  color: var(--sg-muted);
  font-size: 28rpx;
}
.home-search text {
  margin-left: 16rpx;
}
.feature {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-radius: 24rpx;
  background: var(--sg-canvas);
  min-height: 364rpx;
  box-sizing: border-box;
}
.feature-copy {
  flex: 1;
  min-width: 0;
}
.feature-title {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.35;
}
.feature-note {
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--sg-muted);
  margin: 12rpx 0 28rpx;
}
.feature-button {
  min-height: 44px;
  width: 264rpx;
  max-width: 100%;
  background: var(--sg-brand);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.feature-photo {
  width: 190rpx;
  height: 266rpx;
  flex-shrink: 0;
  border-radius: 14rpx;
  margin-left: 20rpx;
}
.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32rpx 0 14rpx;
}
.section-title {
  font-size: 34rpx;
  font-weight: 600;
}
.section-action {
  min-height: 44px;
  display: flex;
  align-items: center;
  color: var(--sg-muted);
  font-size: 25rpx;
}
.section-action t-icon {
  margin-left: 8rpx;
}
.quick-tools {
  display: flex;
}
.quick-item {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
  padding: 28rpx 6rpx;
  box-sizing: border-box;
  background: var(--sg-soft);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--sg-brand);
}
.quick-item:last-child {
  margin-right: 0;
}
.quick-item text {
  font-size: 26rpx;
  margin-top: 16rpx;
  color: var(--sg-text);
}
.continue-head {
  margin-top: 28rpx;
}
.draft-row {
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  padding: 24rpx;
  background: var(--sg-soft);
}
.draft-thumb {
  width: 80rpx;
  height: 106rpx;
  margin-right: 24rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.thumb-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--sg-muted);
  background: var(--sg-bg);
}
.draft-copy {
  flex: 1;
  min-width: 0;
}
.draft-title {
  font-size: 28rpx;
  font-weight: 600;
}
.draft-note {
  font-size: 23rpx;
  color: var(--sg-muted);
  line-height: 1.7;
  margin-top: 6rpx;
}
.draft-empty {
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  border-radius: 20rpx;
  background: var(--sg-soft);
}
.empty-draft-icon {
  width: 60rpx;
  min-width: 60rpx;
  color: var(--sg-muted);
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.empty-draft-title {
  font-size: 27rpx;
}
.home-error {
  margin-top: 24rpx;
}
@media (prefers-color-scheme: dark) {
  .feature-button {
    color: #10251b;
  }
}

.feature-fan {
  position: relative;
  width: 296rpx;
  height: 300rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
}
.feature-card {
  position: absolute;
  width: 164rpx;
  height: 244rpx;
  box-sizing: border-box;
  border: 6rpx solid #fff;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  transform-origin: 50% 100%;
  box-shadow: 0 10rpx 24rpx rgba(37, 99, 235, 0.12);
}
.feature-card-male {
  left: 36rpx;
  bottom: 12rpx;
  transform: rotate(-12deg);
  z-index: 1;
}
.feature-card-female {
  right: 24rpx;
  bottom: 28rpx;
  transform: rotate(10deg);
  z-index: 2;
}
.feature-portrait {
  width: 100%;
  height: 100%;
  display: block;
}
@media (prefers-color-scheme: dark) {
  .feature-card {
    box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.24);
  }
}
