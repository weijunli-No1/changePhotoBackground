.home-body { padding: 12rpx var(--sg-gutter) 38rpx; }
.home-search, .feature-main, .feature-button, .feature-size, .feature-options,
.feature-option, .print-entry, .print-action, .section-head, .section-action, .draft-resume {
  display: flex;
  align-items: center;
}
.home-search {
  min-height: 44px;
  border: 1rpx solid var(--sg-line);
  border-radius: var(--sg-radius-control);
  padding: 0 22rpx;
  background: var(--sg-surface);
  color: var(--sg-muted);
  font-size: var(--sg-font-body);
}
.home-search text { flex: 1; margin-left: 14rpx; }
.feature {
  margin-top: 18rpx;
  padding: 30rpx 28rpx 24rpx;
  border-radius: var(--sg-radius-card);
  background: var(--sg-hero-bg);
  color: var(--sg-hero-ink);
  overflow: hidden;
}
.feature-main { justify-content: space-between; }
.feature-copy { flex: 1; min-width: 0; }
.feature-title { font-size: var(--sg-font-display); line-height: 1.2; font-weight: 700; }
.feature-note { color: var(--sg-hero-subtle); font-size: var(--sg-font-note); margin-top: 10rpx; }
.feature-options {
  align-self: flex-start;
  margin-top: 18rpx;
  display: inline-flex;
  padding: 4rpx;
  border-radius: var(--sg-radius-control);
  background: var(--sg-hero-control);
}
.feature-option {
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  padding: 0 10rpx;
  border-radius: 10rpx;
  color: var(--sg-hero-ink);
  font-size: var(--sg-font-body);
  font-weight: 600;
}
.feature-option.selected { background: var(--sg-hero-cta); color: var(--sg-hero-cta-ink); }
.feature-size { min-height: 44px; font-size: var(--sg-font-note); color: var(--sg-hero-subtle); }
.feature-size t-icon { margin-left: 4rpx; }
.feature-proof { position: relative; width: 260rpx; height: 250rpx; margin-left: 8rpx; flex-shrink: 0; }
.sample-print {
  position: absolute; top: 8rpx; left: 0; width: 150rpx; height: 206rpx; padding: 7rpx 7rpx 0;
  box-sizing: border-box; background: #fffefa; box-shadow: 0 6rpx 16rpx rgba(27, 36, 45, .18);
  transform-origin: center;
}
.sample-print image { width: 100%; height: 171rpx; display: block; }
.photo-back { z-index: 1; transform: translate(8rpx, 1rpx) rotate(-11deg) scale(.92); }
.photo-front { z-index: 2; transform: translate(101rpx, 21rpx) rotate(7deg); }
.proof-caption { display: flex; align-items: center; justify-content: center; line-height: 26rpx; text-align: center; font-size: 18rpx; color: #39434b; }
.proof-caption t-icon { margin-right: 3rpx; }
.large-print { transform: translate(99rpx, 19rpx) rotate(3deg) scale(1.05); }
.feature-button {
  min-height: 48px;
  margin-top: 14rpx;
  padding: 0 24rpx;
  border-radius: var(--sg-radius-button);
  background: var(--sg-hero-cta);
  color: var(--sg-hero-cta-ink);
  justify-content: space-between;
  font-size: var(--sg-font-label);
  font-weight: 600;
}
.print-entry {
  margin-top: 14rpx;
  padding: 18rpx 22rpx;
  background: var(--sg-orange-soft);
  border-radius: var(--sg-radius-card);
}
.mini-printer { width: 134rpx; height: 94rpx; position: relative; margin-right: 18rpx; flex-shrink: 0; }
.mini-housing { position: absolute; left: 0; top: 0; width: 134rpx; height: 45rpx; }
.mini-print {
  position: absolute; left: 27rpx; top: 35rpx; box-sizing: border-box;
  width: 80rpx; height: 54rpx; padding: 4rpx; background: #fffefa;
  box-shadow: 0 3rpx 6rpx rgba(47, 36, 16, 0.18); display: flex; flex-wrap: wrap;
}
.theme-sky .mini-housing { height: 37rpx; }
.theme-sky .mini-print { top: 30rpx; }
.theme-peach .mini-print { top: 34rpx; }
.theme-mint .mini-print { top: 36rpx; }
.mini-print image { width: 23rpx; height: 22rpx; margin: 0 1rpx 1rpx 0; }
.print-copy { flex: 1; min-width: 0; }
.print-title, .section-title, .exam-title { font-size: var(--sg-font-section); font-weight: 600; }
.print-note { margin-top: 3rpx; color: var(--sg-muted); font-size: var(--sg-font-note); }
.print-action { min-height: 44px; margin-left: 8rpx; color: var(--sg-brand); font-size: var(--sg-font-note); font-weight: 600; }
.print-action t-icon { margin-left: 5rpx; }
.section-head { justify-content: space-between; margin: 16rpx 0 6rpx; }
.section-action, .draft-resume { min-height: 44px; color: var(--sg-brand); font-size: var(--sg-font-note); }
.section-action t-icon { margin-left: 4rpx; }
.quick-tools {
  display: flex;
  background: var(--sg-surface);
  border: 1rpx solid var(--sg-line);
  border-radius: var(--sg-radius-card);
  padding: 10rpx 0;
}
.quick-item { flex: 1; min-width: 0; padding: 10rpx 0; display: flex; align-items: center; flex-direction: column; }
.quick-icon, .exam-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: var(--sg-radius-control);
}
.quick-item text { margin-top: 8rpx; font-size: var(--sg-font-body); font-weight: 600; }
.exam-entry { display: flex; align-items: center; margin-top: 14rpx; padding: 18rpx 22rpx; border-radius: var(--sg-radius-card); border: 1rpx solid var(--sg-line); background: var(--sg-surface); }
.exam-icon { color: var(--sg-green-ink); background: var(--sg-green-soft); }
.exam-copy, .draft-copy { flex: 1; min-width: 0; }
.exam-copy { margin: 0 16rpx; }
.exam-title { color: var(--sg-text); }
.draft-note { color: var(--sg-muted); font-size: var(--sg-font-note); margin-top: 4rpx; }
.exam-arrow {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--sg-surface);
  display: flex;
  align-items: center;
  justify-content: center;
}
.draft-row {
  display: flex;
  align-items: center;
  border: 1rpx solid var(--sg-line);
  border-radius: var(--sg-radius-card);
  padding: 14rpx 20rpx;
  background: var(--sg-surface);
}
.draft-thumb {
  width: 82rpx;
  height: 104rpx;
  margin-right: 20rpx;
  border-radius: var(--sg-radius-small);
  flex-shrink: 0;
}
.thumb-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--sg-muted);
  background: var(--sg-soft);
}
.draft-title { font-size: var(--sg-font-body); font-weight: 600; }
.draft-resume { margin-left: 8rpx; }
.home-error { margin-top: 16rpx; }
.photo-pressed { opacity: .87; }
@media (prefers-reduced-motion: no-preference) {
  .sample-print { transition: transform 220ms ease-out; }
  .feature-button, .print-entry { transition: transform 120ms ease-out; }
  .photo-pressed { transform: scale(.985); }
}

.feature-button.working { background: var(--sg-disabled-bg); color: var(--sg-disabled-text); }


.sample-in-motion, .motion-quiet .sample-print { transition: none; }
.sample-motion-preference { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
/* Some Skyline versions apply both unknown queries. Only an exclusive match represents a preference. */
@media (prefers-reduced-motion: reduce) { .sample-motion-preference { width: 2px; } }
@media (prefers-reduced-motion: no-preference) { .sample-motion-preference { height: 2px; } }
