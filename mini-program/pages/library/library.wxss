.library-header {
  padding: 12rpx var(--sg-gutter) 0;
  flex-shrink: 0;
}
.catalog-search {
  display: flex;
  align-items: center;
  background: var(--sg-surface);
  border: 1rpx solid var(--sg-line);
  border-radius: var(--sg-radius-control);
  padding-left: 24rpx;
  min-height: 88rpx;
  color: var(--sg-muted);
}
.catalog-search input {
  flex: 1;
  min-width: 0;
  height: 44px;
  font-size: var(--sg-font-body);
  color: var(--sg-text);
  margin-left: 16rpx;
}
.search-clear {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.catalog-body {
  padding: 0 var(--sg-gutter) 40rpx;
}
.catalog-group { margin-top: 24rpx; }
.catalog-heading {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12rpx; font-size: var(--sg-font-section); font-weight: 600;
}
.catalog-description { color: var(--sg-muted); font-size: var(--sg-font-note); font-weight: 400; }
.tool-list { padding: 0 18rpx; border: 1rpx solid var(--sg-line); border-radius: var(--sg-radius-card); background: var(--sg-surface); }
.catalog-tool { display: flex; align-items: center; min-height: 110rpx; padding: 14rpx 0; box-sizing: border-box; border-bottom: 1rpx solid var(--sg-line); }
.catalog-tool:last-child { border: 0; }
.catalog-icon {
  width: 72rpx; height: 72rpx; border-radius: var(--sg-radius-control); display: flex;
  align-items: center; justify-content: center; margin-right: 16rpx; flex-shrink: 0;
}
.portrait-icon { background: var(--sg-brand-soft); }
.portrait-icon image { width: 40rpx; height: 52rpx; border: 3rpx solid #fffdf6; transform: rotate(-6deg); }
.catalog-copy { flex: 1; min-width: 0; padding-right: 8rpx; }
.catalog-name { color: var(--sg-text); font-size: var(--sg-font-label); font-weight: 600; }
.catalog-description { line-height: 1.5; margin-top: 3rpx; }
.catalog-local {
  color: var(--sg-green-ink); font-size: var(--sg-font-caption); margin-right: 6rpx; flex-shrink: 0;
}
.catalog-empty { padding: 72rpx 22rpx; text-align: center; color: var(--sg-muted); }
.catalog-empty .secondary { margin-top: 24rpx; }
.catalog-error { margin-top: 20rpx; }
.category-row {
  display: flex; align-items: center; position: relative; margin-top: 12rpx; padding: 4rpx;
  background: var(--sg-soft); border-radius: var(--sg-radius-control);
}
.category-tab {
  display: flex; align-items: center; justify-content: center; flex: 1; min-width: 0; min-height: 44px;
  border-radius: var(--sg-radius-small); color: var(--sg-muted); font-size: var(--sg-font-body);
}
.category-tab.selected { background: var(--sg-surface); color: var(--sg-brand); font-weight: 600; }
.catalog-indicator {
  pointer-events: none;
  position: absolute; z-index: 1; left: 0; bottom: 5rpx; height: 4rpx; border-radius: 6rpx; background: var(--sg-brand); opacity: 0;
}
.quick-queries { display: flex; margin-top: 3rpx; }
.query-chip { display: flex; align-items: center; min-height: 44px; padding-right: 14rpx; color: var(--sg-brand); font-size: var(--sg-font-note); }
.chip-face { display: flex; align-items: center; justify-content: center; padding: 4rpx 14rpx; border: 1rpx solid var(--sg-line); border-radius: var(--sg-radius-control); background: var(--sg-surface); }
.chip-face text { margin-left: 5rpx; }
.spec-more { min-height: 44px; display: flex; align-items: center; color: var(--sg-brand); font-size: var(--sg-font-note); }
.matched-spec {
  display: flex; align-items: center; min-height: 44px; box-sizing: border-box; padding: 16rpx 20rpx;
  border-radius: var(--sg-radius-control); background: var(--sg-brand-soft); color: var(--sg-brand); margin-bottom: 8rpx;
}

.search-placeholder { color: var(--sg-muted); }
