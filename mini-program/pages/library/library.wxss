.library-header {
  padding: 20rpx 36rpx 0;
  flex-shrink: 0;
}
.catalog-search {
  display: flex;
  align-items: center;
  background: var(--sg-soft);
  border-radius: var(--sg-radius-card);
  padding-left: 24rpx;
  min-height: 88rpx;
  color: var(--sg-muted);
}
.catalog-search input {
  flex: 1;
  min-width: 0;
  height: 44px;
  font-size: var(--sg-font-body);
  color: var(--sg-text);
  margin-left: 16rpx;
}
.search-clear {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.catalog-tabs {
  width: 100%;
  height: 52px;
  min-height: 52px;
  white-space: nowrap;
  margin-top: 16rpx;
}
.category-row {
  display: inline-flex;
  height: 52px;
}
.category-tab {
  min-height: 48px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  font-size: var(--sg-font-body);
  margin-right: 44rpx;
  color: var(--sg-muted);
  border-bottom: 4rpx solid transparent;
}
.category-tab.selected {
  border-color: var(--sg-brand);
  color: var(--sg-brand);
  font-weight: 600;
}
.catalog-body {
  padding: 0 36rpx 40rpx;
}
.catalog-group {
  margin-top: 24rpx;
}
.catalog-heading {
  font-size: var(--sg-font-section);
  font-weight: 600;
  margin-bottom: 12rpx;
}
.catalog-tool {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--sg-line);
}
.catalog-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--sg-radius-card);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.catalog-portrait {
  width: 68rpx;
  height: 94rpx;
  border-radius: 6rpx;
}
.catalog-copy {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}
.catalog-name {
  font-size: var(--sg-font-label);
  font-weight: 600;
}
.catalog-description {
  font-size: var(--sg-font-note);
  line-height: 1.7;
  color: var(--sg-muted);
  margin-top: 8rpx;
}
.catalog-local {
  font-size: var(--sg-font-caption);
  color: var(--sg-muted);
  margin-top: 6rpx;
}
.catalog-empty {
  padding: 90rpx 0;
  text-align: center;
  color: var(--sg-muted);
}
.catalog-empty .secondary {
  margin-top: 36rpx;
}
.catalog-error {
  margin-top: 24rpx;
}

.category-row {
  position: relative;
}
.catalog-indicator {
  position: absolute;
  left: 0;
  bottom: 4px;
  height: 4rpx;
  background: var(--sg-brand);
  opacity: 0;
}
.motion-tabs .category-tab.selected {
  border-color: transparent;
}

.catalog-local {
  display: inline-flex;
  color: var(--sg-green);
  background: var(--sg-green-soft);
  border-radius: var(--sg-radius-small);
  padding: 2rpx 10rpx;
}

.category-row {
  display: flex;
  width: 678rpx;
}
.category-tab {
  flex: 1;
  margin-right: 0;
  justify-content: center;
}

.catalog-local {
  margin: 0 12rpx 0 0;
  flex-shrink: 0;
  font-size: var(--sg-font-caption);
  color: var(--sg-green-ink);
}

/* Short, centered selection marker matching the V3 tabs. */
.category-tab {
  position: relative;
}
.category-tab.selected {
  border-bottom-color: transparent;
}
.category-tab.selected::after {
  content: "";
  position: absolute;
  left: calc(50% - 32rpx);
  bottom: 0;
  width: 64rpx;
  height: 6rpx;
  border-radius: 8rpx;
  background: var(--sg-brand);
}
.motion-tabs .category-tab.selected::after {
  opacity: 0;
}
