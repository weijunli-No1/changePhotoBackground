<import src="../../templates/studio-tabs.wxml" />
<view class="page-wrap theme-{{studioTheme.id}} profile-page">
  <navigation-bar title="我的" />
  <scroll-view class="page-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="page-content profile-content">
      <view class="profile-intro">
        <view
          class="profile-avatar"
          bindtap="{{hasLogin ? 'editProfile' : 'onLogin'}}"
          hover-class="pressed"
          aria-role="button"
          aria-label="{{hasLogin ? '编辑头像昵称' : '微信登录'}}"
          ><image
            wx:if="{{avatarUrl}}"
            src="{{avatarUrl}}"
            class="profile-avatar-image"
            mode="aspectFill"
            binderror="avatarError" /><t-icon wx:else name="user" size="56rpx"
        /></view>
        <view class="profile-identity"
          ><view class="profile-name">{{hasLogin ? nickname : '我的照相馆'}}</view
          ><view
            wx:if="{{hasLogin}}"
            class="profile-edit"
            bindtap="editProfile"
            hover-class="pressed"
            aria-role="button"
            >编辑资料<t-icon name="chevron-right" size="28rpx" /></view
          ><block wx:else
            ><view class="profile-desc">登录可同步云端作品。</view
            ><view
              class="profile-login"
              bindtap="onLogin"
              hover-class="pressed"
              aria-role="button"
              aria-disabled="{{busy}}"
              >{{busy ? '正在登录…' : '微信登录'}}</view
            ></block
          ></view
        >
      </view>
      <view wx:if="{{busy}}" class="cancel-login" bindtap="cancelLogin" aria-role="button"
        >取消登录</view
      >
      <view wx:if="{{error}}" class="error-inline profile-error" aria-role="alert"
        >{{error}}</view
      >
      <view class="profile-section">我的照片</view>
      <view class="profile-albums">
        <view class="album-entry" data-tab="drafts" bindtap="openWorks" hover-class="pressed" aria-role="button">
          <view class="album-icon"><t-icon name="edit" size="37rpx" /></view>
          <view class="album-copy"><view class="album-name">本地草稿</view>
            <view class="album-caption">{{draftCount ? draftCount + ' 份可续编' : '保存在本机'}}</view></view>
          <t-icon name="chevron-right" size="25rpx" />
        </view>
        <view class="album-entry" data-tab="cloud" bindtap="openWorks" hover-class="pressed" aria-role="button">
          <view class="album-icon cloud"><t-icon name="cloud" size="37rpx" /></view>
          <view class="album-copy"><view class="album-name">云端作品</view>
            <view class="album-caption">{{hasLogin ? '查看证件照' : '登录后可看'}}</view></view>
          <t-icon name="chevron-right" size="25rpx" />
        </view>
      </view>
      <view
        wx:if="{{memberAvailable === true}}"
        class="member-card"
        bindtap="openMembership"
        hover-class="pressed"
        aria-role="button"
      >
        <image class="member-crown" src="/assets/images/member-emblem.png" mode="aspectFit" aria-hidden="{{true}}" /><view class="member-copy"
          ><view class="member-title"
            >{{!memberKnown ? (memberLoading ? '正在同步会员权益' : '会员权益暂未同步') : isLifetimeMember ? '永久会员 · 已开通'
            : '拾光永久会员'}}</view
          >
          <view class="member-desc"
            >{{!memberKnown ? '点开查看权益' : isLifetimeMember ? '无限保存 · 免广告' : '无限保存 · 免广告'}}</view
          ></view
        >
        <view class="member-link"
          >{{!memberKnown ? '查看' : '查看权益'}}<t-icon
            name="chevron-right"
            size="28rpx"
        /></view>
      </view>
      <view class="usage-card"
        ><view class="usage-main"
          ><t-icon name="file-image" size="48rpx" /><view class="usage-copy"
            ><view class="usage-title">证件照保存机会</view
            ><view class="usage-caption"
              >{{isLifetimeMember ? '永久会员' : hasLogin ? '今日可用' :
              '每日免费额度'}}</view
            ></view
          ><view
            class="usage-value {{!usageKnown && hasLogin || unlimited ? 'usage-text' : ''}}"
            >{{!hasLogin ? '5 次 / 天' : usageKnown ? (unlimited ? '不限次数' : remaining
            + ' 次') : usageBusy ? '查询中…' : '暂未获取'}}</view
          ></view
        ><view class="usage-note"
          ><t-icon name="info-circle-filled" size="26rpx" /><text
            >{{isLifetimeMember ? '永久会员，无限保存且免广告' : hasLogin ?
            '完整观看视频可增加次数' : '登录后显示今日剩余次数'}}</text
          ></view
        ></view
      >
      <view wx:if="{{hasLogin && usageError}}" class="usage-error"
        ><text>{{usageError}}</text
        ><view
          class="usage-retry"
          bindtap="fetchUsage"
          hover-class="pressed"
          aria-role="button"
          >{{usageBusy ? '查询中…' : '重新查询'}}</view
        ></view
      >
      <view class="profile-theme"><theme-picker id="studio-theme-picker" /></view>
      <view class="profile-section">服务与设置</view>
      <view class="profile-menu">
        <view wx:if="{{memberAvailable !== true}}" class="menu-row" bindtap="openMembership" hover-class="pressed" aria-role="button">
          <t-icon name="user-vip" size="36rpx" /><text class="menu-text">永久会员</text>
          <text class="menu-value">{{memberAvailable === false ? '暂未开放' : memberLoading ? '查询中' : '查看状态'}}</text>
          <t-icon name="chevron-right" size="28rpx" />
        </view>
        <view
          class="menu-row support-entry"
          bindtap="openSupport"
          hover-class="pressed"
          aria-role="button"
          ><t-icon name="service" size="36rpx" /><text class="menu-text">帮助与客服</text
          ><t-icon name="chevron-right" size="28rpx"
        /></view>
        <view
          class="menu-row privacy-entry"
          bindtap="navToPrivacy"
          hover-class="pressed"
          aria-role="button"
          ><t-icon name="lock-on" size="36rpx" /><text class="menu-text"
            >隐私安全政策</text
          ><t-icon name="chevron-right" size="28rpx"
        /></view>
        <view
          class="menu-row agreement-entry"
          bindtap="navToAgreement"
          hover-class="pressed"
          aria-role="button"
          ><t-icon name="info-circle" size="36rpx" /><text class="menu-text"
            >用户须知</text
          ><t-icon name="chevron-right" size="28rpx"
        /></view>
      </view>
      <view wx:if="{{hasLogin}}" class="logout-area"
        ><button
          class="logout-button"
          bindtap="onLogout"
          disabled="{{loggingOut}}"
          loading="{{loggingOut}}"
          hover-class="pressed"
        >
          {{loggingOut ? '正在退出…' : '退出登录'}}</button
        ><view class="logout-note">退出后，本机草稿和个人资料仍会保留。</view></view
      >
    </view>
  </scroll-view>
  <template is="studio-tabs" data="{{current: 'profile'}}" />
</view>
