<view class="page-wrap">
  <navigation-bar title="我的" />
  <scroll-view class="page-scroll" scroll-y show-scrollbar="{{false}}">
    <view class="page-content profile-content">
      <view class="profile-intro">
        <view
          class="profile-avatar"
          bindtap="{{hasLogin ? 'editProfile' : 'onLogin'}}"
          hover-class="pressed"
          aria-role="button"
          aria-label="{{hasLogin ? '编辑头像昵称' : '微信登录'}}"
          ><image
            wx:if="{{avatarUrl}}"
            src="{{avatarUrl}}"
            class="profile-avatar-image"
            mode="aspectFill"
            binderror="avatarError" /><t-icon wx:else name="user" size="56rpx"
        /></view>
        <view class="profile-identity"
          ><view class="profile-name"
            >{{hasLogin ? nickname : '欢迎使用拾光小相'}}</view
          ><view
            wx:if="{{hasLogin}}"
            class="profile-edit"
            bindtap="editProfile"
            hover-class="pressed"
            aria-role="button"
            >编辑头像昵称<t-icon name="chevron-right" size="28rpx" /></view
          ><block wx:else
            ><view class="profile-desc">先试用，保存时再登录。</view
            ><view
              class="profile-login"
              bindtap="onLogin"
              hover-class="pressed"
              aria-role="button"
              aria-disabled="{{busy}}"
              >{{busy ? '正在登录…' : '微信登录'}}</view
            ></block
          ></view
        >
      </view>
      <view
        wx:if="{{busy}}"
        class="cancel-login"
        bindtap="cancelLogin"
        aria-role="button"
        >取消登录</view
      >
      <view
        wx:if="{{error}}"
        class="error-inline profile-error"
        aria-role="alert"
        >{{error}}</view
      >
      <view class="usage-card"
        ><view class="usage-copy"
          ><view class="usage-title">证件照保存机会</view
          ><view class="usage-note"
            >{{hasLogin ? '完整观看视频可增加次数' :
            '登录后显示今日剩余次数'}}</view
          ></view
        ><view
          class="usage-value {{!usageKnown && hasLogin || unlimited ? 'usage-text' : ''}}"
          >{{!hasLogin ? '5 次 / 天' : usageKnown ? (unlimited ? '不限次数' :
          remaining + ' 次') : usageBusy ? '查询中…' : '暂未获取'}}</view
        ></view
      >
      <view wx:if="{{hasLogin && usageError}}" class="usage-error"
        ><text>{{usageError}}</text
        ><view
          class="usage-retry"
          bindtap="fetchUsage"
          hover-class="pressed"
          aria-role="button"
          >{{usageBusy ? '查询中…' : '重新查询'}}</view
        ></view
      >
      <view class="profile-menu">
        <view
          class="menu-row"
          bindtap="openDrafts"
          hover-class="pressed"
          aria-role="button"
          ><t-icon name="file" size="36rpx" /><text class="menu-text"
            >我的本地草稿</text
          ><text class="menu-value">{{draftCount}}份</text
          ><t-icon name="chevron-right" size="28rpx"
        /></view>
        <view
          class="menu-row"
          bindtap="openSupport"
          hover-class="pressed"
          aria-role="button"
          ><t-icon name="service" size="36rpx" /><text class="menu-text"
            >帮助与客服</text
          ><t-icon name="chevron-right" size="28rpx"
        /></view>
        <view
          class="menu-row"
          bindtap="navToPrivacy"
          hover-class="pressed"
          aria-role="button"
          ><t-icon name="lock-on" size="36rpx" /><text class="menu-text"
            >隐私安全政策</text
          ><t-icon name="chevron-right" size="28rpx"
        /></view>
        <view
          class="menu-row"
          bindtap="navToAgreement"
          hover-class="pressed"
          aria-role="button"
          ><t-icon name="info-circle" size="36rpx" /><text class="menu-text"
            >用户须知</text
          ><t-icon name="chevron-right" size="28rpx"
        /></view>
      </view>
      <view wx:if="{{hasLogin}}" class="logout-area"
        ><button
          class="logout-button"
          bindtap="onLogout"
          disabled="{{loggingOut}}"
          loading="{{loggingOut}}"
          hover-class="pressed"
        >
          {{loggingOut ? '正在退出…' : '退出登录'}}</button
        ><view class="logout-note"
          >退出后，本机草稿和个人资料仍会保留。</view
        ></view
      >
    </view>
  </scroll-view>
</view>
