.profile-content {
  padding: 0 var(--sg-gutter) 32rpx;
}
.profile-section { margin: 28rpx 0 14rpx; font-size: var(--sg-font-section); font-weight: 600; }
.profile-intro {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-top: 12rpx;
  border-radius: var(--sg-radius-card);
  background: var(--sg-hero-bg);
  color: var(--sg-hero-ink);
}
.profile-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 104rpx;
  height: 116rpx;
  margin-right: 24rpx;
  border: 6rpx solid #f2f1e7;
  border-bottom-width: 14rpx;
  border-radius: var(--sg-radius-small);
  box-sizing: border-box;
  background: var(--sg-brand-soft);
  color: var(--sg-brand);
  overflow: hidden;
  flex-shrink: 0;
}
.profile-avatar-image {
  width: 100%;
  height: 100%;
  flex-shrink: 0;
}
.profile-identity {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}
.profile-name {
  font-size: var(--sg-font-title);
  line-height: 1.4;
  font-weight: 700;
  word-break: break-all;
}
.profile-edit {
  min-height: 44px;
  display: flex;
  align-items: center;
  font-size: var(--sg-font-body);
  color: var(--sg-hero-ink);
}
.profile-edit t-icon {
  margin-left: 8rpx;
}
.profile-desc {
  font-size: var(--sg-font-note);
  line-height: 1.6;
  color: var(--sg-hero-subtle);
  margin: 8rpx 0;
}
.profile-login {
  min-height: 44px;
  display: inline-flex;
  padding: 0 28rpx;
  align-items: center;
  border-radius: var(--sg-radius-button);
  background: var(--sg-hero-cta);
  color: var(--sg-hero-cta-ink);
  font-size: var(--sg-font-body);
  font-weight: 600;
}
.cancel-login {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--sg-font-body);
  color: var(--sg-brand);
  margin-top: 12rpx;
}
.member-card {
  position: relative;
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  margin: 20rpx 0 16rpx;
  border-radius: var(--sg-radius-card);
  background: var(--sg-hero-bg);
  color: var(--sg-hero-ink);
}
.member-crown {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.member-copy {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}
.member-title {
  font-size: var(--sg-font-label);
  font-weight: 700;
}
.member-desc {
  font-size: var(--sg-font-note);
  color: var(--sg-hero-ink);
  margin-top: 6rpx;
  line-height: 1.6;
}
.member-link {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  color: var(--sg-hero-ink);
  background: transparent;
  border-radius: var(--sg-radius-button);
  font-size: var(--sg-font-note);
  font-weight: 600;
  flex-shrink: 0;
}
.usage-card {
  padding: 22rpx;
  border: 1rpx solid var(--sg-line);
  border-radius: var(--sg-radius-card);
  background: var(--sg-surface);
}
.usage-main {
  display: flex;
  align-items: center;
}
.usage-main > t-icon {
  color: var(--sg-green-ink);
  margin-right: 16rpx;
  flex-shrink: 0;
}
.usage-copy {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}
.usage-title {
  font-size: var(--sg-font-body);
  font-weight: 600;
}
.usage-caption {
  font-size: var(--sg-font-note);
  color: var(--sg-muted);
  margin-top: 4rpx;
}
.usage-note {
  display: flex;
  align-items: center;
  padding: 10rpx 14rpx;
  border-radius: var(--sg-radius-small);
  background: var(--sg-green-soft);
  font-size: var(--sg-font-note);
  color: var(--sg-green-ink);
  line-height: 1.6;
  margin-top: 16rpx;
}
.usage-note t-icon {
  margin-right: 12rpx;
  flex-shrink: 0;
}
.usage-value {
  color: var(--sg-text);
  font-size: var(--sg-font-display);
  font-weight: 700;
  flex-shrink: 0;
}
.usage-value.usage-text {
  font-size: var(--sg-font-body);
}
.usage-error {
  padding: 12rpx 0;
  font-size: var(--sg-font-note);
  color: var(--sg-danger);
}
.usage-retry {
  display: flex;
  align-items: center;
  min-height: 44px;
  color: var(--sg-brand);
}
.profile-error {
  margin: 20rpx 0;
}
.profile-menu {
  background: var(--sg-surface);
  padding: 0 22rpx;
  border: 1rpx solid var(--sg-line);
  border-radius: var(--sg-radius-card);
  margin-top: 16rpx;
}
.profile-albums {
  display: flex;
  align-items: stretch;
  margin: 0 -6rpx;
}
.album-entry {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 22rpx 12rpx;
  margin: 0 6rpx;
  border: 1px solid var(--sg-line);
  border-radius: var(--sg-radius-card);
  background: var(--sg-surface);
  color: var(--sg-muted);
}
.album-icon {
  width: 56rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--sg-radius-small);
  flex-shrink: 0;
  background: var(--sg-brand-soft);
  color: var(--sg-brand);
}
.album-icon.cloud { background: var(--sg-green-soft); color: var(--sg-green-ink); }
.album-copy { flex: 1; min-width: 0; padding: 0 8rpx 0 12rpx; }
.album-name { color: var(--sg-text); font-size: var(--sg-font-body); font-weight: 600; }
.album-caption { margin-top: 4rpx; font-size: var(--sg-font-caption); }
.menu-row {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 1rpx solid var(--sg-line);
  font-size: var(--sg-font-body);
  color: var(--sg-text);
}
.menu-row:last-child {
  border-bottom: 0;
}
.menu-text {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}
.menu-value {
  font-size: var(--sg-font-note);
  color: var(--sg-muted);
  margin-right: 12rpx;
}
.logout-area {
  margin-top: 20rpx;
}
.profile-content .logout-button {
  width: 100%;
  max-width: none;
  margin: 0;
  min-height: 44px;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sg-soft);
  color: var(--sg-muted);
  border: 1rpx solid var(--sg-line);
  border-radius: var(--sg-radius-button);
  font-size: var(--sg-font-body);
  font-weight: 600;
  line-height: 1.4;
}
.logout-button::after {
  border: 0;
}
.logout-note {
  font-size: var(--sg-font-caption);
  line-height: 1.7;
  color: var(--sg-muted);
  text-align: center;
  margin-top: 14rpx;
}
@media (prefers-color-scheme: dark) {
  .usage-note {
    color: var(--sg-brand);
  }
}
@media (max-width: 340px) {
  .member-title {
    font-size: var(--sg-font-body);
  }
  .member-desc {
    font-size: var(--sg-font-caption);
  }
  .profile-name {
    font-size: var(--sg-font-section);
  }
}

.usage-note text {
  margin-left: 12rpx;
}

.usage-card { margin-top: 16rpx; }

.profile-theme { margin-top: 20rpx; }
