.profile-content {
  padding-top: 36rpx;
}
.profile-intro {
  display: flex;
  align-items: center;
  padding: 0 0 36rpx;
}
.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sg-soft);
  color: var(--sg-brand);
  flex-shrink: 0;
  overflow: hidden;
  margin-right: 28rpx;
}
.profile-avatar-image {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  border-radius: 64rpx;
}
.profile-identity {
  flex: 1;
  min-width: 0;
}
.profile-name {
  font-size: 36rpx;
  line-height: 1.5;
  font-weight: 600;
  word-break: break-all;
}
.profile-edit {
  min-height: 44px;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: var(--sg-muted);
}
.profile-edit t-icon {
  margin-left: 8rpx;
}
.profile-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--sg-muted);
  margin: 4rpx 0;
}
.profile-login {
  min-height: 44px;
  display: flex;
  align-items: center;
  color: var(--sg-brand);
  font-size: 28rpx;
  font-weight: 600;
}
.cancel-login {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--sg-muted);
  margin-top: -20rpx;
}
.usage-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  background: var(--sg-soft);
  border-radius: 20rpx;
}
.usage-copy {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}
.usage-title {
  font-size: 28rpx;
  font-weight: 600;
}
.usage-note {
  font-size: 23rpx;
  color: var(--sg-muted);
  line-height: 1.7;
  margin-top: 8rpx;
}
.usage-value {
  color: var(--sg-brand);
  font-size: 42rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.usage-value.usage-text {
  font-size: 26rpx;
}
.usage-error {
  padding: 12rpx 0;
  font-size: 24rpx;
  color: var(--sg-danger);
}
.usage-retry {
  display: flex;
  align-items: center;
  min-height: 44px;
  color: var(--sg-brand);
}
.profile-error {
  margin-bottom: 24rpx;
}
.profile-menu {
  margin-top: 28rpx;
}
.menu-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
  border-bottom: 1rpx solid var(--sg-line);
  font-size: 28rpx;
  color: var(--sg-text);
}
.menu-text {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}
.menu-value {
  font-size: 24rpx;
  color: var(--sg-muted);
  margin-right: 12rpx;
}
.logout-area {
  margin-top: 48rpx;
}
.profile-content .logout-button {
  width: 100%;
  max-width: none;
  margin: 0;
  min-height: 48px;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sg-surface);
  color: var(--sg-danger);
  border: 1rpx solid var(--sg-danger);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.4;
}
.logout-button::after {
  border: 0;
}
.logout-note {
  font-size: 23rpx;
  line-height: 1.7;
  color: var(--sg-muted);
  text-align: center;
  margin-top: 20rpx;
}
