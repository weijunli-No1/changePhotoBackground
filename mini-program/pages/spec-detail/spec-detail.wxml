<view class="page-wrap theme-{{studioTheme.id}}">
  <navigation-bar title="{{selectOnly ? '更改照片规格' : '规格与制作方式'}}" show-back="{{true}}" />
  <scroll-view class="page-scroll" scroll-y scroll-into-view="{{requirementsTarget}}" show-scrollbar="{{false}}">
    <view class="detail-body">
      <block wx:if="{{spec}}">
        <view class="detail-proof">
          <view class="detail-proof-copy">
            <view class="detail-title">{{spec.name}}</view>
            <view class="proof-dimensions">{{spec.width}} × {{spec.height}} px</view>
          </view>
          <view class="detail-paper" aria-hidden="{{true}}">
            <size-sample theme-id="{{studioTheme.id}}" photo-width="{{spec.width}}" photo-height="{{spec.height}}" reference="{{0}}" edge="{{122}}" guides="{{true}}" />
            <text>输出比例</text>
          </view>
        </view>
        <view class="creation-title">照片要求</view>
        <view class="requirement-list">
          <view class="requirement-row"><text>尺寸要求</text><text class="requirement-value">{{spec.dimensionLabel}}</text></view>
          <view class="requirement-row"><text>照片格式</text><text class="requirement-value">{{spec.format}}</text></view>
          <view class="requirement-row"><text>背景颜色</text><text class="requirement-value">{{spec.background}}</text></view>
          <view class="requirement-row"><text>文件大小</text><text class="requirement-value">{{spec.fileRule}}</text></view>
          <view class="requirements-toggle" bindtap="toggleRequirements" hover-class="pressed"
            aria-role="button" aria-expanded="{{expanded}}">
            <text>{{expanded ? '收起详细要求' : spec.sourceUrl ? '详细要求与官方来源' : '查看详细要求'}}</text>
            <t-icon name="{{expanded ? 'chevron-up' : 'chevron-down'}}" size="28rpx" />
          </view>
          <block wx:if="{{expanded}}">
            <view id="requirement-source" class="notice detail-notice">{{spec.notice}}</view>
            <view wx:if="{{spec.sourceUrl}}" class="source-section">
              <view class="source-label">{{spec.sourceLabel}}</view><view class="source-date">核对日期 {{spec.reviewedAt}}</view>
              <view class="source-link" bindtap="source" aria-role="button" aria-disabled="{{copyingSource}}">
                {{copyingSource ? '正在复制…' : '复制官方来源链接'}}<t-icon name="link" size="28rpx" /></view>
            </view>
          </block>
        </view>
        <block wx:if="{{!selectOnly}}">
          <view class="creation-title">制作方式</view>
          <view class="creation-modes" aria-role="radiogroup">
            <view wx:if="{{spec.category !== 'common'}}" class="creation-mode {{mode === 'original' ? 'selected' : ''}}"
              data-mode="original" bindtap="setMode" hover-class="pressed" aria-role="radio"
              aria-checked="{{mode === 'original'}}" aria-disabled="{{choosing}}">
              <view class="method-icon"><t-icon name="image" size="36rpx" /></view>
              <view class="creation-copy"><view class="creation-name">原图尺寸适配</view>
                <view class="creation-note">保留原背景</view></view>
              <t-icon name="{{mode === 'original' ? 'check-circle-filled' : 'circle'}}" size="34rpx" />
            </view>
            <view class="creation-mode {{mode === 'smart' ? 'selected' : ''}}"
              data-mode="smart" bindtap="setMode" hover-class="pressed" aria-role="radio"
              aria-checked="{{mode === 'smart'}}" aria-disabled="{{choosing}}">
              <view class="method-icon"><t-icon name="palette" size="36rpx" /></view>
              <view class="creation-copy"><view class="creation-name">智能换底色</view>
                <view class="creation-note">照片将上传云端</view></view>
              <t-icon name="{{mode === 'smart' ? 'check-circle-filled' : 'circle'}}" size="34rpx" />
            </view>
          </view>
          <view wx:if="{{spec.category !== 'common'}}" class="detail-explanation">{{mode === 'smart' ? '报名禁止修图时，请使用原照。' : '请核对原照底色与着装。'}}</view>
        </block>
        <view wx:else class="detail-explanation">沿用当前照片和底色。</view>
      </block>
      <view wx:if="{{error}}" class="error-inline" aria-role="alert">{{error}}</view>
    </view>
  </scroll-view>
  <view class="footer-actions">
    <view wx:if="{{spec}}" class="primary {{choosing ? 'disabled' : ''}}" bindtap="start" hover-class="pressed" aria-role="button"
      aria-disabled="{{choosing}}">{{choosing ? '正在打开照片…' : selectOnly ? '使用此规格' : mode === 'smart' ? '选照片，智能换底色' : '选原照，适配尺寸'}}</view>
    <view wx:else class="primary" bindtap="returnToSpecs" hover-class="pressed" aria-role="button">重新选择规格</view>
  </view>
</view>
