.detail-body {
  padding: 24rpx 36rpx 36rpx;
}
.detail-title {
  font-size: var(--sg-font-title);
  line-height: 1.4;
  font-weight: 600;
}
.detail-subtitle {
  color: var(--sg-muted);
  font-size: var(--sg-font-body);
  margin-top: 12rpx;
}
.dimension-banner {
  display: flex;
  align-items: center;
  justify-content: space-around;
  padding: 20rpx 12rpx;
  background: var(--sg-brand-soft);
  border-radius: var(--sg-radius-control);
  margin-top: 24rpx;
}
.dimension-caption {
  font-size: var(--sg-font-body);
  color: var(--sg-muted);
  text-align: center;
}
.dimension-number {
  font-size: var(--sg-font-title);
  font-weight: 600;
  margin-top: 6rpx;
}
.dimension-number text {
  display: inline;
  font-size: var(--sg-font-body);
  margin-left: 4rpx;
}
.dimension-divider {
  height: 80rpx;
  width: 1rpx;
  background: var(--sg-line);
}
.dimension-note {
  font-size: var(--sg-font-note);
  color: var(--sg-muted);
  margin: 12rpx 0 20rpx;
}
.requirement-list {
  border: 1rpx solid var(--sg-line);
  border-radius: var(--sg-radius-control);
  padding: 0 24rpx;
}
.requirement-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  min-height: 76rpx;
  padding: 20rpx 0;
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--sg-line);
}
.requirement-row:last-child {
  border: 0;
}
.requirement-row > text:first-child {
  flex-shrink: 0;
  font-size: var(--sg-font-body);
}
.requirement-value {
  color: var(--sg-muted);
  text-align: right;
  margin-left: 28rpx;
  font-size: var(--sg-font-body);
}
.detail-notice {
  margin-top: 16rpx;
}
.detail-explanation,
.source-label,
.source-date {
  color: var(--sg-muted);
  font-size: var(--sg-font-note);
  line-height: 1.8;
}
.detail-explanation {
  margin-top: 12rpx;
}
.source-section {
  margin-top: 24rpx;
}
.source-link {
  color: var(--sg-brand);
  font-size: var(--sg-font-body);
  display: flex;
  align-items: center;
  min-height: 44px;
}
.source-link t-icon {
  margin-left: 12rpx;
}
.creation-title {
  font-size: var(--sg-font-label);
  font-weight: 600;
  margin-top: 28rpx;
}
.creation-modes {
  margin-top: 16rpx;
}
.creation-mode {
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 1rpx solid var(--sg-line);
  border-radius: var(--sg-radius-control);
  margin-bottom: 12rpx;
  min-height: 44px;
  box-sizing: border-box;
}
.creation-copy {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}
.creation-mode t-icon {
  color: var(--sg-muted);
  flex-shrink: 0;
}
.creation-mode.selected t-icon {
  color: var(--sg-brand);
}
.requirements-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
  margin-top: 16rpx;
  font-size: var(--sg-font-body);
  color: var(--sg-brand);
}
.creation-mode.selected {
  border-color: var(--sg-brand);
  background: var(--sg-brand-soft);
}
.creation-name {
  font-size: var(--sg-font-body);
  font-weight: 600;
}
.creation-note {
  font-size: var(--sg-font-note);
  color: var(--sg-muted);
  margin-top: 8rpx;
}
