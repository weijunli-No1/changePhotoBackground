.detail-body { padding: 14rpx var(--sg-gutter) 32rpx; }
.detail-proof, .creation-mode, .requirements-toggle, .source-link, .detail-paper, .method-icon { display: flex; align-items: center; }
.detail-proof { background: var(--sg-brand-soft); border-radius: var(--sg-radius-card); padding: 24rpx; }
.detail-proof-copy { flex: 1; min-width: 0; }
.detail-title { font-size: var(--sg-font-title); line-height: 1.35; font-weight: 700; }
.proof-dimensions { color: var(--sg-brand); font-size: var(--sg-font-label); font-weight: 600; margin-top: 4rpx; }
.detail-paper {
  flex-shrink: 0; flex-direction: column; justify-content: center; margin-left: 16rpx;
  width: 152rpx; padding: 10rpx 0; border-radius: var(--sg-radius-control); background: var(--sg-surface);
}
.detail-paper text { font-size: var(--sg-font-caption); color: var(--sg-muted); }
.creation-title { font-size: var(--sg-font-section); font-weight: 600; margin: 22rpx 0 12rpx; }
.requirement-list { padding: 0 20rpx; background: var(--sg-surface); border: 1rpx solid var(--sg-line); border-radius: var(--sg-radius-card); }
.requirement-row {
  display: flex; align-items: flex-start; justify-content: space-between; min-height: 66rpx; padding: 16rpx 0;
  box-sizing: border-box; border-bottom: 1rpx solid var(--sg-line); font-size: var(--sg-font-body);
}
.requirement-row > text:first-child { color: var(--sg-muted); flex-shrink: 0; }
.requirement-value { text-align: right; margin-left: 20rpx; }
.requirements-toggle { min-height: 44px; justify-content: space-between; color: var(--sg-brand); font-size: var(--sg-font-note); }
.detail-notice { margin-bottom: 12rpx; }
.source-section { padding: 4rpx 0 8rpx; }
.source-label, .source-date, .detail-explanation, .creation-note { color: var(--sg-muted); font-size: var(--sg-font-note); line-height: 1.6; }
.source-link { min-height: 44px; font-size: var(--sg-font-note); color: var(--sg-brand); }
.source-link t-icon { margin-left: 8rpx; }
.creation-mode {
  min-height: 94rpx; box-sizing: border-box; padding: 14rpx 20rpx; margin-bottom: 10rpx; border: 1px solid var(--sg-line);
  border-radius: var(--sg-radius-control); background: var(--sg-surface); color: var(--sg-muted);
}
.creation-mode.selected { background: var(--sg-brand-soft); border-color: var(--sg-brand); color: var(--sg-brand); }
.method-icon { width: 58rpx; margin-right: 12rpx; justify-content: center; flex-shrink: 0; }
.creation-copy { flex: 1; min-width: 0; margin-right: 12rpx; }
.creation-name { color: var(--sg-text); font-size: var(--sg-font-body); font-weight: 600; }
.creation-note { margin-top: 2rpx; }
.detail-explanation { margin: 12rpx 2rpx 0; }
.error-inline { margin-top: 14rpx; }
@media (prefers-reduced-motion: no-preference) {
  .creation-mode { transition: border-color 150ms ease-out, background-color 150ms ease-out; }
}
