<view class="page-wrap theme-{{studioTheme.id}} specs-page">
  <navigation-bar title="选择照片规格" show-back="{{true}}" />
  <view class="spec-search-wrap">
    <view class="spec-search-bar">
      <view class="spec-search">
        <t-icon name="search" size="36rpx" />
        <input value="{{query}}" bindinput="search" placeholder-class="search-placeholder" placeholder="搜索考试、证件或尺寸"
          maxlength="60" confirm-type="search" aria-label="搜索考试、证件或尺寸" />
        <view wx:if="{{query}}" class="clear-query" bindtap="clearSearch"
          aria-role="button" aria-label="清空搜索"><t-icon name="close-circle-filled" size="32rpx" /></view>
      </view>
      <view class="custom-entry" bindtap="custom" aria-role="button" hover-class="pressed"
        aria-label="自定义照片像素尺寸"><t-icon name="edit" size="28rpx" />自定义</view>
    </view>
    <view class="spec-category-row" aria-role="tablist">
      <view wx:for="{{categories}}" wx:key="id" class="spec-category {{category === item.id ? 'active' : ''}}"
        data-id="{{item.id}}" bindtap="selectCategory" aria-role="tab" aria-selected="{{category === item.id}}">{{item.name}}</view>
    </view>
  </view>
  <scroll-view class="page-scroll" scroll-y show-scrollbar="{{false}}" scroll-top="{{scrollTop}}">
    <view class="spec-list">
      <view wx:if="{{query}}" class="result-count" aria-role="status">找到 {{count}} 项规格</view>
      <view wx:if="{{error}}" class="error-inline" aria-role="alert">{{error}}</view>
      <view wx:for="{{groups}}" wx:for-item="group" wx:key="id" class="spec-group">
        <view wx:if="{{group.collapsible}}" class="group-heading group-toggle" data-id="{{group.id}}"
          bindtap="toggleGroup" aria-role="button" aria-expanded="{{group.expanded}}" hover-class="pressed">
          <text>{{group.name}}</text><text class="group-count">{{group.items.length}} 项</text>
          <view class="group-arrow {{group.expanded ? 'expanded' : ''}}"><t-icon name="chevron-down" size="28rpx" /></view>
        </view>
        <view wx:else class="group-heading">{{group.name}}</view>
        <block wx:if="{{!group.collapsible || group.expanded}}">
          <view wx:if="{{group.id === 'common' || group.id === 'more-common'}}" class="format-grid" aria-role="radiogroup" aria-label="常用规格">
            <view wx:for="{{group.items}}" wx:key="id"
              class="format-card {{item.width === selectedSize.width && item.height === selectedSize.height ? 'selected' : ''}}"
              data-id="{{item.id}}" bindtap="selectCommon" hover-class="pressed" aria-role="radio"
              aria-checked="{{item.width === selectedSize.width && item.height === selectedSize.height}}"
              aria-label="{{item.name + '，' + item.dimensionLabel}}">
              <view class="format-card-head"><size-sample theme-id="{{studioTheme.id}}" photo-width="{{item.width}}" photo-height="{{item.height}}" edge="{{80}}" portrait="/assets/images/sample-female-smile.jpg" />
                <t-icon name="{{item.width === selectedSize.width && item.height === selectedSize.height ? 'check-circle-filled' : 'circle'}}" size="34rpx" /></view>
              <view class="spec-row-name">{{item.name}}</view>
              <view class="spec-row-note">{{item.width}} × {{item.height}} px</view>
            </view>
          </view>
          <view wx:else class="exam-list">
            <view wx:for="{{group.items}}" wx:key="id" class="spec-row" data-id="{{item.id}}" bindtap="showDetail"
              hover-class="pressed" aria-role="button" aria-label="{{item.name + '，' + item.dimensionLabel}}">
              <view class="spec-row-copy"><view class="spec-row-name">{{item.name}}</view>
                <view class="spec-row-note">{{item.dimensionLabel}}</view>
              </view>
              <t-icon name="chevron-right" size="30rpx" />
            </view>
          </view>
        </block>
      </view>
      <view wx:if="{{!count}}" class="empty-state">
        <view class="empty-icon"><t-icon name="search" size="48rpx" /></view>
        <view class="empty-title">未找到匹配规格</view>
        <view class="empty-desc">也可自定义尺寸。</view>
        <view wx:if="{{category !== 'all'}}" class="secondary" bindtap="broadenSearch" aria-role="button">在全部分类搜索</view>
        <view wx:else class="secondary" bindtap="clearSearch" aria-role="button">清空搜索</view>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{showSelection}}" class="footer-actions specs-footer">
    <view class="selection-summary">
      <view class="selected-name">已选 · {{selectedSize.name}}</view>
      <view class="selected-pixels">{{selectedSize.width}} × {{selectedSize.height}} px</view>
    </view>
    <view class="primary {{choosing ? 'disabled' : ''}}" bindtap="confirmSelection" aria-role="button"
      aria-disabled="{{choosing}}" hover-class="pressed">{{choosing ? '正在选择照片…' : selectOnly ? '应用所选规格' : '选照片，云端制作'}}<t-icon wx:if="{{!choosing}}" name="arrow-right" size="28rpx" /></view>
  </view>
  <spec-picker theme-id="{{studioTheme.id}}" show-catalog="{{false}}" start-custom="{{true}}" visible="{{specVisible}}" title="自定义照片尺寸"
    description="{{selectOnly ? '' : '照片将上传至云端制作。'}}"
    current-width="{{selectedSize.width}}" current-height="{{selectedSize.height}}"
    bind:select="selectCustom" bind:close="closeSpecs" />
</view>
