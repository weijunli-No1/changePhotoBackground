.spec-search-wrap { padding: 12rpx var(--sg-gutter) 0; flex-shrink: 0; }
.spec-search-bar, .spec-search, .clear-query, .custom-entry, .spec-category-row,
.spec-category, .format-card-head, .spec-row, .group-toggle, .group-arrow, .specs-footer {
  display: flex; align-items: center;
}
.spec-search {
  flex: 1; min-width: 0; min-height: 44px; box-sizing: border-box; border-radius: var(--sg-radius-control);
  border: 1rpx solid var(--sg-line); background: var(--sg-surface); padding-left: 18rpx; color: var(--sg-muted);
}
.spec-search input { flex: 1; min-width: 0; height: 44px; padding: 0 8rpx; font-size: var(--sg-font-body); color: var(--sg-text); }
.clear-query { width: 44px; height: 44px; justify-content: center; }
.custom-entry {
  margin-left: 14rpx; padding: 0 16rpx; min-height: 44px; border-radius: var(--sg-radius-control);
  color: var(--sg-brand); background: var(--sg-brand-soft); font-size: var(--sg-font-note); font-weight: 600;
}
.custom-entry t-icon { margin-right: 5rpx; }
.spec-category-row { margin-top: 12rpx; background: var(--sg-soft); padding: 4rpx; border-radius: var(--sg-radius-control); }
.spec-category { flex: 1; min-height: 44px; justify-content: center; font-size: var(--sg-font-body); color: var(--sg-muted); border-radius: var(--sg-radius-small); }
.spec-category.active { color: var(--sg-brand); font-weight: 600; background: var(--sg-surface); }
.spec-list { padding: 0 var(--sg-gutter) 32rpx; }
.spec-group { margin-top: 22rpx; }
.group-heading { font-size: var(--sg-font-section); font-weight: 600; margin: 0 0 12rpx; }
.group-toggle {
  min-height: 48px; padding: 0 20rpx; border: 1rpx solid var(--sg-line); background: var(--sg-surface);
  border-radius: var(--sg-radius-control); font-size: var(--sg-font-label);
}
.group-toggle > text:first-child { flex: 1; }
.group-count, .result-count, .selected-pixels, .spec-row-note { color: var(--sg-muted); font-size: var(--sg-font-note); }
.group-count { margin-right: 10rpx; font-weight: 400; }
.group-arrow { color: var(--sg-muted); }
.group-arrow.expanded { transform: rotate(180deg); }
.format-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.format-card {
  width: 48.5%; box-sizing: border-box; padding: 14rpx 20rpx 18rpx; margin-bottom: 8rpx;
  border: 1px solid var(--sg-line); border-radius: var(--sg-radius-card); background: var(--sg-surface);
}
.format-card.selected { background: var(--sg-brand-soft); border-color: var(--sg-brand); }
.format-card-head { justify-content: space-between; color: var(--sg-muted); margin-bottom: 6rpx; }
.format-card.selected .format-card-head { color: var(--sg-brand); }
.exam-list { overflow: hidden; border: 1rpx solid var(--sg-line); border-radius: var(--sg-radius-card); background: var(--sg-surface); padding: 0 18rpx; }
.spec-row { min-height: 98rpx; padding: 16rpx 0; box-sizing: border-box; border-bottom: 1rpx solid var(--sg-line); }
.spec-row:last-child { border: 0; }
.spec-row-copy, .selection-summary { flex: 1; min-width: 0; padding-right: 14rpx; }
.selected-name { word-break: break-all; }
.spec-row-name, .selected-name { font-size: var(--sg-font-label); font-weight: 600; }
.spec-row-note { margin-top: 4rpx; line-height: 1.5; }
.spec-row t-icon { color: var(--sg-muted); }
.result-count { margin-top: 20rpx; }
.selected-pixels { margin-top: 4rpx; }
.specs-footer { padding-top: 16rpx; }
.specs-footer .primary { width: auto; max-width: 58%; }
.specs-footer .primary t-icon { margin-left: 8rpx; }
@media (prefers-reduced-motion: no-preference) {
  .format-card, .spec-category { transition: background-color 150ms ease-out, border-color 150ms ease-out; }
  .group-arrow { transition: transform 150ms ease-out; }
}

.search-placeholder { color: var(--sg-muted); }
