.specs-page {
  background: var(--sg-bg);
}
.spec-search-wrap {
  padding: 20rpx 36rpx 0;
  background: var(--sg-bg);
  flex-shrink: 0;
}
.spec-search {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-radius: var(--sg-radius-card);
  background: var(--sg-soft);
  padding-left: 24rpx;
  color: var(--sg-muted);
}
.spec-search input {
  flex: 1;
  min-width: 0;
  height: 44px;
  padding: 0 16rpx;
  font-size: var(--sg-font-body);
  color: var(--sg-text);
}
.clear-query {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.spec-categories {
  height: 100rpx;
  white-space: nowrap;
  margin-top: 8rpx;
}
.spec-category-row {
  display: flex;
  height: 100rpx;
}
.spec-category {
  flex: 1;
  justify-content: center;
  display: flex;
  align-items: center;
  min-height: 44px;
  font-size: var(--sg-font-body);
  color: var(--sg-muted);
  border-bottom: 5rpx solid transparent;
  box-sizing: border-box;
}
.spec-category.active {
  color: var(--sg-brand);
  border-color: var(--sg-brand);
  font-weight: 600;
}
.spec-list {
  padding: 0 36rpx 24rpx;
}
.spec-group {
  margin-top: 24rpx;
}
.group-heading {
  font-size: var(--sg-font-section);
  font-weight: 600;
  margin-bottom: 14rpx;
}
.spec-row {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--sg-line);
  box-sizing: border-box;
}
.spec-group:first-child .spec-row {
  padding: 20rpx;
  border: 1rpx solid var(--sg-line);
  border-radius: var(--sg-radius-card);
  margin-bottom: 12rpx;
}
.spec-row.selected {
  border-color: var(--sg-brand) !important;
  background: var(--sg-brand-soft);
}
.spec-format-icon {
  width: 76rpx;
  height: 100rpx;
  background: var(--sg-canvas);
  color: var(--sg-brand);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  margin-right: 22rpx;
  flex-shrink: 0;
}
.spec-row-copy {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}
.spec-row-name {
  font-size: var(--sg-font-label);
  font-weight: 600;
}
.spec-row-note {
  font-size: var(--sg-font-note);
  color: var(--sg-muted);
  margin-top: 6rpx;
  line-height: 1.5;
}
.background-note {
  font-size: var(--sg-font-note);
  margin-top: 4rpx;
}
.spec-row t-icon {
  color: var(--sg-muted);
  flex-shrink: 0;
}
.spec-row.selected t-icon {
  color: var(--sg-brand);
}
.result-count {
  color: var(--sg-muted);
  font-size: var(--sg-font-note);
  margin-top: 24rpx;
}
.specs-footer {
  padding-top: 12rpx;
}
.spec-advice {
  display: flex;
  align-items: center;
  border-radius: var(--sg-radius-control);
  padding: 10rpx 16rpx;
  background: var(--sg-green-soft);
  color: var(--sg-green);
  font-size: var(--sg-font-note);
}
.spec-advice text {
  margin-left: 10rpx;
}
.selection-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
}
.selected-copy {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}
.selected-name {
  font-size: var(--sg-font-body);
  font-weight: 600;
  margin-right: 16rpx;
}
.selected-pixels {
  color: var(--sg-muted);
  font-size: var(--sg-font-note);
}
.custom-entry {
  color: var(--sg-brand);
  font-size: var(--sg-font-note);
  display: flex;
  align-items: center;
  min-height: 44px;
  margin-left: 12rpx;
  flex-shrink: 0;
}
@media (prefers-color-scheme: dark) {
  .spec-advice {
    color: #92dfbb;
  }
}

.spec-category-row {
  width: 678rpx;
}

/* Short, centered selection marker matching the V3 tabs. */
.spec-category {
  position: relative;
}
.spec-category.active {
  border-bottom-color: transparent;
}
.spec-category.active::after {
  content: "";
  position: absolute;
  left: calc(50% - 32rpx);
  bottom: 0;
  width: 64rpx;
  height: 6rpx;
  border-radius: 8rpx;
  background: var(--sg-brand);
}
