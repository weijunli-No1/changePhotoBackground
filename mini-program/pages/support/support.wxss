.support-body {
  padding: 32rpx 40rpx 48rpx;
}
.support-title {
  font-size: 40rpx;
  font-weight: 600;
}
.support-intro {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--sg-muted);
  line-height: 1.8;
}
.faq-heading {
  margin: 44rpx 0 12rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.faq-item {
  border-bottom: 1rpx solid var(--sg-line);
}
.faq-item .faq-question {
  width: 100%;
  max-width: none;
  margin: 0;
  min-height: 112rpx;
  padding: 24rpx 0;
  background: transparent;
  color: var(--sg-text);
  font-weight: 400;
  font-size: 28rpx;
  line-height: 1.6;
  display: flex;
  align-items: center;
  border-radius: 0;
}
.faq-label {
  flex: 1;
  text-align: left;
  padding-right: 20rpx;
}
.faq-question::after,
.device-copy::after,
.primary::after {
  border: 0;
}
.faq-answer {
  padding: 0 0 28rpx;
  color: var(--sg-muted);
  font-size: 26rpx;
  line-height: 1.9;
}
.feedback-note {
  margin-top: 36rpx;
  font-size: 24rpx;
  color: var(--sg-muted);
  line-height: 1.8;
}
.support-body .device-copy {
  width: 100%;
  max-width: none;
  margin: 20rpx 0 0;
  padding: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sg-soft);
  color: var(--sg-brand);
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 400;
}
.device-copy text {
  margin-left: 12rpx;
}
.error-inline {
  margin-top: 24rpx;
}
.footer-actions {
  flex-shrink: 0;
}
.footer-actions .primary {
  width: 100%;
  max-width: none;
  margin: 0;
}
.contact-note {
  text-align: center;
  margin-top: 16rpx;
  color: var(--sg-muted);
  font-size: 22rpx;
  line-height: 1.6;
}
