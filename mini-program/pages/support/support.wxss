.support-body {
  padding: 32rpx var(--sg-gutter) 48rpx;
}
.support-title {
  font-size: var(--sg-font-title);
  font-weight: 600;
}
.support-intro {
  margin-top: 16rpx;
  font-size: var(--sg-font-body);
  color: var(--sg-muted);
  line-height: 1.8;
}
.faq-heading {
  margin: 44rpx 0 12rpx;
  font-size: var(--sg-font-label);
  font-weight: 600;
}
.feedback-note {
  margin-top: 36rpx;
  font-size: var(--sg-font-note);
  color: var(--sg-muted);
  line-height: 1.8;
}
.support-body .device-copy {
  width: 100%;
  max-width: none;
  margin: 20rpx 0 0;
  padding: 16rpx 24rpx;
  min-height: 44px;
  border: 1rpx solid var(--sg-line);
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--sg-soft);
  color: var(--sg-brand);
  border-radius: var(--sg-radius-button);
  font-size: var(--sg-font-body);
  font-weight: 600;
}
.device-copy text {
  margin-left: 12rpx;
}
.error-inline {
  margin-top: 24rpx;
}
.footer-actions {
  flex-shrink: 0;
}
.footer-actions .primary {
  width: 100%;
  max-width: none;
  margin: 0;
}
.contact-note {
  text-align: center;
  margin-top: 16rpx;
  color: var(--sg-muted);
  font-size: var(--sg-font-caption);
  line-height: 1.6;
}

.device-copy::after { border: 0; }
