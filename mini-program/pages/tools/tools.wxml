<view class="page-wrap theme-{{studioTheme.id}} tool-page">
  <navigation-bar
    title="{{mode === 'compress' ? '图片压缩' : '裁剪旋转'}}"
    show-back="{{true}}"
  />
  <scroll-view class="page-scroll" scroll-y show-scrollbar="{{false}}"
    ><view class="local-body">
      <view class="tool-heading">
        <view class="tool-heading-text">{{sourcePath ? '照片预览' : '效果示例'}}</view>
        <view wx:if="{{sourcePath}}" class="change-photo" bindtap="choosePhoto" hover-class="pressed"
          aria-role="button" aria-disabled="{{processing || opening || adjusting}}">
          <t-icon name="refresh" size="28rpx"/><text>换照片</text>
        </view>
        <text wx:else class="stage-meta">本机处理</text>
      </view>
      <view
        class="local-preview tool-stage {{mode === 'crop' ? 'crop-stage' : ''}}"
        bindtap="{{!sourcePath ? 'choosePhoto' : ''}}"
        aria-role="{{sourcePath ? 'group' : 'button'}}"
        aria-label="{{sourcePath ? '照片预览' : '选择照片，在本机处理'}}"
      >
        <canvas
          wx:if="{{needsCanvas}}"
          type="2d"
          id="toolCanvas"
          class="tool-canvas"
        ></canvas
        ><image
          wx:if="{{sourcePath && !(mode === 'crop' && cropPreviewReady)}}"
          src="{{displayPath || sourcePath}}"
          mode="aspectFit"
          class="local-image"
        /><view
          wx:if="{{sourcePath && mode === 'crop' && cropPreviewReady}}"
          class="crop-frame {{adjusting ? 'moving' : ''}}"
          style="{{cropFrameStyle}}"
          ><image
            class="crop-source"
            src="{{sourcePath}}"
            mode="scaleToFill"
            style="{{cropImageStyle}}{{cropFallbackTransform}}" /><view
            class="crop-guide"
            ><view class="crop-guide-v first"></view
            ><view class="crop-guide-v second"></view
            ><view class="crop-guide-h first"></view
            ><view class="crop-guide-h second"></view></view>
          <view wx:if="{{(canMoveX || canMoveY) && !processing && !opening}}"
            class="crop-touch" bindtouchstart="startCropDrag" catchtouchmove="moveCropDrag"
            bindtouchend="endCropDrag" bindtouchcancel="cancelCropDrag" aria-hidden="true"></view></view
        ><view wx:if="{{!sourcePath}}" class="sample-stage" aria-hidden="true">
          <view wx:if="{{mode === 'crop'}}" class="sample-print crop-sample"
            style="width:{{(ratio || 0.7143) * 260}}rpx;">
            <image src="/assets/images/sample-female-smile.jpg" mode="aspectFill"/>
            <view class="crop-guide">
              <view class="crop-guide-v first"></view><view class="crop-guide-v second"></view>
              <view class="crop-guide-h first"></view><view class="crop-guide-h second"></view>
            </view>
          </view>
          <block wx:else>
            <view class="sample-print compress-original"><image src="/assets/images/sample-male-apricot.jpg" mode="aspectFill"/></view>
            <view class="sample-arrow"><t-icon name="arrow-right" size="38rpx"/></view>
            <view class="sample-print compress-output"><image src="/assets/images/sample-male-apricot.jpg" mode="aspectFill"/></view>
          </block>
        </view><view wx:if="{{processing}}" class="tool-processing"
          ><view class="loading-spinner"></view><text>{{mode === 'compress' ? '正在计算输出体积…' : '正在生成裁剪照片…'}}</text></view
        ></view
      >
      <view wx:if="{{sourcePath && mode === 'compress'}}" class="compression-summary">
        <view class="compression-head">
          <text>文件体积</text>
          <text class="compression-delta" wx:if="{{resultPath && sizeChange}}">{{sizeChange}}</text>
        </view>
        <view class="size-line">
          <text>原图</text>
          <view class="size-track"><view class="size-bar" style="width:{{sourceBar}}%;"></view></view>
          <text class="byte-value">{{sourceSize}}</text>
        </view>
        <view class="size-line">
          <text>输出</text>
          <view class="size-track"><view class="size-bar output" style="width:{{resultPath ? resultBar : 0}}%;"></view></view>
          <text class="byte-value">{{resultPath ? resultSize : '—'}}</text>
        </view>
        <text wx:if="{{resultPath}}" class="output-dimensions">{{width}} × {{height}} px · JPEG</text>
      </view>
      <view wx:elif="{{sourcePath}}" class="file-summary"
        ><text>原图 {{sourceSize}}</text
        ><text
          >{{resultPath ? resultSize + ' · ' + width + ' × ' + height + ' px' :
          ''}}</text
        ></view
      >
      <view class="local-settings">
        <block wx:if="{{mode === 'compress'}}"
          ><view class="setting-title">画质</view
          ><view class="choice-row"
            ><view
              wx:for="{{qualityOptions}}"
              wx:key="value"
              class="choice {{quality === item.value ? 'active' : ''}}"
              data-quality="{{item.value}}" hover-class="pressed"
              aria-checked="{{quality === item.value}}"
              aria-disabled="{{processing || opening || adjusting}}"
              bindtap="setQuality"
              aria-role="radio"
              >{{item.label}}</view
            ></view
          ><view class="setting-title">最长边</view
          ><view class="choice-row"
            ><view
              wx:for="{{edges}}"
              wx:key="*this"
              class="choice {{maxEdge === item ? 'active' : ''}}"
              data-edge="{{item}}" hover-class="pressed"
              aria-checked="{{maxEdge === item}}"
              aria-disabled="{{processing || opening || adjusting}}"
              bindtap="setEdge"
              aria-role="radio"
              >{{item}} px</view
            ></view
          ></block
        >
        <block wx:else
          ><view class="setting-title">裁剪比例</view
          ><view class="ratio-row"
            ><view
              wx:for="{{ratios}}"
              wx:key="name"
              class="ratio-choice {{ratio === item.value ? 'active' : ''}}"
              data-index="{{index}}" hover-class="pressed"
              aria-checked="{{ratio === item.value}}"
              aria-disabled="{{processing || opening || adjusting}}"
              bindtap="setRatio"
              aria-role="radio"
              >{{item.name}}</view
            ></view
          ><view wx:if="{{sourcePath}}" class="rotate-row"
            ><view class="secondary" bindtap="rotate" aria-role="button" aria-disabled="{{processing || opening || adjusting}}" hover-class="pressed"
              ><t-icon name="rotate" size="34rpx" /><text>旋转 90°</text></view
            ><view class="secondary" bindtap="reset" aria-role="button" aria-disabled="{{processing || opening || adjusting}}" hover-class="pressed"
              ><t-icon name="rollback" size="32rpx"/><text>还原</text></view
            ></view
          ><block wx:if="{{ratio}}"
            ><block wx:if="{{canMoveX}}"
              ><view class="slider-label"
                ><text>左右构图</text
                ><text>{{adjusting ? '实时预览' : positionX + '%'}}</text></view
              ><slider
                disabled="{{processing || opening}}"
                min="0"
                max="100"
                value="{{positionX}}"
                activeColor="{{studioAccent || '#4f55ce'}}"
                bindchanging="previewPositionX"
                bindtouchcancel="cancelPosition"
                bindchange="positionX" /></block
            ><block wx:if="{{canMoveY}}"
              ><view class="slider-label"
                ><text>上下构图</text
                ><text>{{adjusting ? '实时预览' : positionY + '%'}}</text></view
              ><slider
                disabled="{{processing || opening}}"
                min="0"
                max="100"
                value="{{positionY}}"
                activeColor="{{studioAccent || '#4f55ce'}}"
                bindchanging="previewPositionY"
                bindtouchcancel="cancelPosition"
                bindchange="positionY" /></block></block
          ><view class="setting-hint"
            >{{canMoveX || canMoveY ? '拖动照片微调构图' : 'PNG · 最长边 4096 px'}}</view
          ></block
        >
        <view wx:if="{{sourcePath && !returnToEditor}}" class="local-links">
          <view class="link" bindtap="makeIdPhoto" aria-role="button" hover-class="pressed"
            aria-disabled="{{processing || opening || adjusting || !resultPath}}">
            <text>用此图制作证件照</text><t-icon name="chevron-right" size="26rpx"/>
          </view>
        </view>
      </view>
    </view></scroll-view
  >
  <view class="footer-actions">
      <view wx:if="{{openingError}}" class="error-inline" aria-role="alert"
        >{{openingError}}</view
      >
      <view wx:if="{{error}}" class="error-inline" aria-role="alert"
        >{{error}}</view
      >
      <view wx:if="{{error && sourcePath}}" class="recovery-actions"
        ><view
          class="link"
          bindtap="retry"
          hover-class="pressed"
          aria-role="button"
          >{{errorRecovery === 'retry' ? '重试处理' : '重新选择照片'}}</view
        ></view
      >
    <view
      class="primary {{processing || opening || adjusting || (sourcePath && !resultPath) ? 'disabled' : ''}}"
      aria-disabled="{{processing || opening || adjusting || (sourcePath && !resultPath)}}"
      bindtap="primary"
      hover-class="pressed"
      aria-role="button"
      >{{opening ? '正在准备…' : adjusting ? '松手生成照片' : processing ?
      '正在处理…' : !sourcePath ? '选择自己的照片' : returnToEditor ? '应用到证件照' : '预览并保存'}}</view
    ></view
  >
</view>
