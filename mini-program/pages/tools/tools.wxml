<view class="page-wrap tool-page">
  <navigation-bar
    title="{{mode === 'compress' ? '图片压缩' : '裁剪旋转'}}"
    show-back="{{true}}"
  />
  <scroll-view class="page-scroll" scroll-y show-scrollbar="{{false}}"
    ><view class="local-body">
      <view
        class="local-preview"
        bindtap="{{!sourcePath ? 'choosePhoto' : ''}}"
        aria-role="{{sourcePath ? 'img' : 'button'}}"
        aria-label="{{sourcePath ? '照片预览' : '选择照片，在本机处理'}}"
      >
        <canvas
          wx:if="{{needsCanvas}}"
          type="2d"
          id="toolCanvas"
          class="tool-canvas"
        ></canvas
        ><image
          wx:if="{{sourcePath && !(mode === 'crop' && cropPreviewReady)}}"
          src="{{displayPath || sourcePath}}"
          mode="aspectFit"
          class="local-image"
        /><view
          wx:if="{{sourcePath && mode === 'crop' && cropPreviewReady}}"
          class="crop-frame"
          style="{{cropFrameStyle}}"
          ><image
            class="crop-source"
            src="{{sourcePath}}"
            mode="scaleToFill"
            style="{{cropImageStyle}}{{cropFallbackTransform}}" /><view
            class="crop-guide"
            ><view class="crop-guide-v first"></view
            ><view class="crop-guide-v second"></view
            ><view class="crop-guide-h first"></view
            ><view class="crop-guide-h second"></view></view></view
        ><view wx:if="{{!sourcePath}}" class="upload-local"
          ><t-icon name="image-add" size="72rpx" /><text>选择一张照片</text
          ><text class="small muted">照片在本机处理</text></view
        ><view wx:if="{{processing}}" class="tool-processing"
          ><view class="loading-spinner"></view><text>正在处理…</text></view
        ></view
      >
      <view wx:if="{{sourcePath}}" class="file-summary"
        ><text>原图 {{sourceSize}}</text
        ><text
          >{{resultPath ? resultSize + ' · ' + width + ' × ' + height + ' px' :
          ''}}</text
        ></view
      >
      <view wx:if="{{sourcePath}}" class="local-settings">
        <block wx:if="{{mode === 'compress'}}"
          ><view class="setting-title">压缩方式</view
          ><view class="choice-row"
            ><view
              wx:for="{{qualityOptions}}"
              wx:key="value"
              class="choice {{quality === item.value ? 'active' : ''}}"
              data-quality="{{item.value}}"
              aria-checked="{{quality === item.value}}"
              aria-disabled="{{processing || opening}}"
              bindtap="setQuality"
              aria-role="radio"
              >{{item.label}}</view
            ></view
          ><view class="setting-title">最长边像素</view
          ><view class="choice-row"
            ><view
              wx:for="{{edges}}"
              wx:key="*this"
              class="choice {{maxEdge === item ? 'active' : ''}}"
              data-edge="{{item}}"
              aria-checked="{{maxEdge === item}}"
              aria-disabled="{{processing || opening}}"
              bindtap="setEdge"
              aria-role="radio"
              >{{item}} px</view
            ></view
          ><view class="setting-hint"
            >输出为 JPEG。不同原图的体积变化不同，请以实际结果为准。</view
          ></block
        >
        <block wx:else
          ><view class="setting-title">裁剪比例</view
          ><view class="ratio-row"
            ><view
              wx:for="{{ratios}}"
              wx:key="name"
              class="ratio-choice {{ratio === item.value ? 'active' : ''}}"
              data-index="{{index}}"
              aria-checked="{{ratio === item.value}}"
              aria-disabled="{{processing || opening}}"
              bindtap="setRatio"
              aria-role="radio"
              >{{item.name}}</view
            ></view
          ><view class="rotate-row"
            ><view class="secondary" bindtap="rotate" aria-role="button"
              ><t-icon name="rotate" size="34rpx" /><text>旋转90°</text></view
            ><view class="secondary" bindtap="reset" aria-role="button"
              >还原</view
            ></view
          ><block wx:if="{{ratio}}"
            ><block wx:if="{{canMoveX}}"
              ><view class="slider-label"
                ><text>左右构图</text
                ><text>{{adjusting ? '实时预览' : positionX + '%'}}</text></view
              ><slider
                disabled="{{processing || opening}}"
                min="0"
                max="100"
                value="{{positionX}}"
                activeColor="{{accentColor}}"
                bindchanging="previewPositionX"
                bindtouchcancel="cancelPosition"
                bindchange="positionX" /></block
            ><block wx:if="{{canMoveY}}"
              ><view class="slider-label"
                ><text>上下构图</text
                ><text>{{adjusting ? '实时预览' : positionY + '%'}}</text></view
              ><slider
                disabled="{{processing || opening}}"
                min="0"
                max="100"
                value="{{positionY}}"
                activeColor="{{accentColor}}"
                bindchanging="previewPositionY"
                bindtouchcancel="cancelPosition"
                bindchange="positionY" /></block></block
          ><view class="setting-hint"
            >保留原图，输出为 JPEG，最长边不超过2560 px。</view
          ></block
        >
        <view class="local-links"
          ><view class="link" bindtap="choosePhoto" aria-role="button"
            >重新选择</view
          ><view
            wx:if="{{!returnToEditor}}"
            class="link"
            bindtap="makeIdPhoto"
            aria-role="button"
            >用于制作证件照</view
          ></view
        >
      </view>
      <view wx:if="{{openingError}}" class="error-inline" aria-role="alert"
        >{{openingError}}</view
      >
      <view wx:if="{{error}}" class="error-inline" aria-role="alert"
        >{{error}}</view
      >
      <view wx:if="{{error}}" class="recovery-actions"
        ><view
          class="link"
          bindtap="retry"
          hover-class="pressed"
          aria-role="button"
          >{{errorRecovery === 'retry' ? '重试处理' : '重新选择照片'}}</view
        ></view
      >
    </view></scroll-view
  >
  <view class="footer-actions"
    ><view
      class="primary {{processing || opening || adjusting || !resultPath ? 'disabled' : ''}}"
      aria-disabled="{{processing || opening || adjusting || !resultPath}}"
      bindtap="goExport"
      hover-class="pressed"
      aria-role="button"
      >{{opening ? '正在准备…' : adjusting ? '松手生成照片' : processing ?
      '正在处理…' : returnToEditor ? '应用到证件照' : '预览并保存'}}</view
    ></view
  >
</view>
