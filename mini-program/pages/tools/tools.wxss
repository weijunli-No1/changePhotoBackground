.local-body { padding: 8rpx var(--sg-gutter) 32rpx; }
.tool-heading, .change-photo, .local-preview, .sample-stage, .sample-arrow, .file-summary, .compression-head, .size-line,
.choice-row, .ratio-row, .choice, .ratio-choice, .rotate-row, .slider-label, .local-links, .tool-processing { display: flex; align-items: center; }
.tool-heading { min-height: 44px; justify-content: space-between; margin-bottom: 12rpx; }
.tool-heading-text { font-size: var(--sg-font-section); font-weight: 650; }
.stage-meta, .file-summary, .output-dimensions { color: var(--sg-muted); font-size: var(--sg-font-note); }
.change-photo { min-height: 44px; color: var(--sg-brand); font-size: var(--sg-font-note); font-weight: 600; }
.change-photo text { margin-left: 8rpx; }
.local-preview { position: relative; justify-content: center; overflow: hidden; }
.local-preview.tool-stage { height: 470rpx; max-height: 38vh; min-height: 165px; }
.local-preview.crop-stage { height: 550rpx; max-height: 40vh; }
.local-image { height: 100%; width: 100%; box-sizing: border-box; padding: 16rpx; }
.sample-stage { width: 100%; justify-content: center; }
.sample-print { position: relative; box-sizing: content-box; padding: 7rpx 7rpx 12rpx; background: #fff; box-shadow: 0 6rpx 15rpx rgba(31,47,37,.13); }
.sample-print image { display: block; width: 100%; height: 100%; }
.crop-sample { height: 260rpx; }
.crop-sample .crop-guide { top: 7rpx; bottom: 7rpx; left: 7rpx; right: 7rpx; }
.compress-original { width: 190rpx; height: 260rpx; transform: rotate(-4deg); }
.compress-output { width: 124rpx; height: 170rpx; transform: rotate(3deg); }
.sample-arrow { margin: 0 32rpx; color: var(--sg-brand); }
.tool-processing {
  position: absolute; bottom: 14rpx; left: 16rpx; padding: 10rpx 16rpx; border-radius: var(--sg-radius-control);
  background: var(--sg-surface); color: var(--sg-brand); font-size: var(--sg-font-note);
}
.tool-processing .loading-spinner { margin-right: 12rpx; }
.file-summary { min-height: 66rpx; justify-content: space-between; }
.local-settings { padding: 0 0 12rpx; }
.setting-title { font-size: var(--sg-font-label); font-weight: 600; margin: 24rpx 0 12rpx; }
.choice-row { border-radius: var(--sg-radius-control); padding: 4rpx; background: var(--sg-soft); border: 1rpx solid var(--sg-line); }
.choice, .ratio-choice {
  flex: 1; min-height: 44px; min-width: 0; justify-content: center; box-sizing: border-box;
  padding: 4rpx; font-size: var(--sg-font-note); color: var(--sg-muted); border-radius: var(--sg-radius-control);
}
.choice.active { color: var(--sg-brand); font-weight: 600; background: var(--sg-surface); box-shadow: 0 2rpx 6rpx rgba(35,54,44,.13); }
.ratio-choice { border: 1rpx solid var(--sg-line); background: var(--sg-surface); }
.ratio-choice + .ratio-choice { margin-left: 8rpx; }
.ratio-choice.active { background: var(--sg-brand-soft); border-color: var(--sg-brand); color: var(--sg-brand); font-weight: 600; }
.rotate-row { margin: 16rpx 0 20rpx; }
.rotate-row .secondary { flex: 1; min-width: 0; }
.rotate-row .secondary + .secondary { margin-left: 12rpx; }
.rotate-row text { margin-left: 10rpx; }
.setting-hint { font-size: var(--sg-font-note); color: var(--sg-muted); margin-top: 18rpx; }
.slider-label { justify-content: space-between; font-size: var(--sg-font-note); color: var(--sg-muted); }
.local-settings slider { margin: 8rpx 14rpx 18rpx; }
.local-links { justify-content: flex-end; margin-top: 14rpx; }
.local-links .link { font-size: var(--sg-font-note); }
.crop-frame { position: relative; overflow: hidden; background: #fff; box-shadow: 0 4rpx 16rpx rgba(31,47,37,.14); }
.crop-touch, .crop-guide { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.crop-source { position: absolute; transform-origin: center center; max-width: none; }
.crop-guide { border: 1px solid rgba(255,255,255,.8); pointer-events: none; }
.crop-guide-v, .crop-guide-h { position: absolute; background: rgba(255,255,255,.62); }
.moving .crop-guide { border-color: var(--sg-brand); }
.moving .crop-guide-v, .moving .crop-guide-h { background: var(--sg-brand-soft); }
.crop-guide-v { top: 0; bottom: 0; width: 1px; }
.crop-guide-h { left: 0; right: 0; height: 1px; }
.crop-guide-v.first { left: 33.333%; }
.crop-guide-v.second { left: 66.667%; }
.crop-guide-h.first { top: 33.333%; }
.crop-guide-h.second { top: 66.667%; }
.compression-summary { margin: 16rpx 0; padding: 18rpx 22rpx; border: 1rpx solid var(--sg-line); border-radius: var(--sg-radius-card); background: var(--sg-surface); }
.compression-head { justify-content: space-between; font-weight: 600; font-size: var(--sg-font-body); }
.compression-delta { color: var(--sg-brand); font-size: var(--sg-font-note); }
.size-line { margin-top: 8rpx; color: var(--sg-muted); font-size: var(--sg-font-note); }
.size-track { flex: 1; margin: 0 16rpx; height: 8rpx; background: var(--sg-soft); border-radius: 8rpx; }
.size-bar { height: 100%; background: var(--sg-muted); border-radius: 8rpx; }
.size-bar.output { background: var(--sg-brand); }
.byte-value { min-width: 108rpx; text-align: right; color: var(--sg-text); }
.output-dimensions { display: block; margin-top: 8rpx; text-align: right; font-size: var(--sg-font-caption); }
.footer-actions .error-inline { margin-bottom: 12rpx; padding: 12rpx 18rpx; }
@media (prefers-reduced-motion: no-preference) {
  .size-bar, .crop-sample { transition: width .2s ease-out; }
}
