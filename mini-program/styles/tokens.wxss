page, :host {
  --sg-font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --sg-font-caption: 22rpx;
  --sg-font-note: 24rpx;
  --sg-font-body: 28rpx;
  --sg-font-label: 30rpx;
  --sg-font-section: 32rpx;
  --sg-font-title: 40rpx;
  --sg-font-display: 48rpx;
  --sg-font-metric: 64rpx;
  --sg-radius-small: 12rpx;
  --sg-radius-control: 16rpx;
  --sg-radius-card: 24rpx;
  --sg-radius-button: 28rpx;
  --sg-radius-hero: 32rpx;
  --sg-gutter: 36rpx;
  --sg-on-brand: #fff;
  --sg-disabled-bg: #e7ecf5;
  --sg-disabled-text: #63718a;
  --sg-bg: #fff;
  --sg-surface: #fff;
  --sg-soft: #f1f5fb;
  --sg-canvas: #eef5ff;
  --sg-text: #142a43;
  --sg-muted: #63718a;
  --sg-line: #e2e8f0;
  --sg-brand: #2358ee;
  --sg-brand-soft: #edf3ff;
  --sg-blue: #2358ee;
  --sg-green: #16885d;
  --sg-green-ink: #16885d;
  --sg-green-soft: #eaf8f1;
  --sg-yellow: #ffe34c;
  --sg-orange: #ff7d43;
  --sg-orange-soft: #fff1de;
  --sg-danger: #ac4939;
  --td-brand-color: #2358ee;
  --td-brand-color-light: #eaf2ff;
  --td-brand-color-focus: #dbeafe;
  --td-brand-color-active: #1d4ed8;
  --td-brand-color-disabled: #bfdbfe;
  --td-text-color-secondary: #63718a;
  --td-text-color-primary: #142a43;
  --td-bg-color-container: #fff;
  color: var(--sg-text);
  font-family: var(--sg-font-family);
  font-size: var(--sg-font-body);
  line-height: 1.5;
}
@media (prefers-color-scheme: dark) {
  page, :host {
    --sg-on-brand: #102144;
    --sg-disabled-bg: #303947;
    --sg-disabled-text: #a6b0c2;
    --sg-bg: #121212;
    --sg-surface: #1c1c1e;
    --sg-soft: #29292c;
    --sg-canvas: #202022;
    --sg-text: #f2f2f4;
    --sg-muted: #ababaf;
    --sg-line: #363639;
    --sg-brand: #91b4ff;
    --sg-blue: #2358ee;
    --sg-green: #16885d;
    --sg-green-soft: #18392d;
    --sg-green-ink: #92dfbb;
    --sg-orange-soft: #3a2a1c;
    --sg-brand-soft: #29292c;
    --sg-danger: #f39c90;
    --td-brand-color: #91b4ff;
    --td-brand-color-light: #29292c;
    --td-brand-color-focus: #203a69;
    --td-brand-color-active: #b5cdff;
    --td-brand-color-disabled: #34415a;
    --td-text-color-secondary: #ababaf;
    --td-text-color-primary: #f2f2f4;
    --td-bg-color-container: #1c1c1e;
  }
}
