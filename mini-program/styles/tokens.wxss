page, :host {
  --sg-font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --sg-font-caption: 22rpx;
  --sg-font-note: 24rpx;
  --sg-font-body: 28rpx;
  --sg-font-label: 28rpx;
  --sg-font-section: 34rpx;
  --sg-font-title: 40rpx;
  --sg-font-display: 48rpx;
  --sg-font-metric: 64rpx;
  --sg-radius-small: 10rpx;
  --sg-radius-control: 14rpx;
  --sg-radius-card: 24rpx;
  --sg-radius-button: 20rpx;
  --sg-radius-hero: 28rpx;
  --sg-gutter: 32rpx;
  color: var(--sg-text);
  font-family: var(--sg-font-family);
  font-size: var(--sg-font-body);
  line-height: 1.5;
}
page, :host, .theme-sky {
  --sg-bg: #f6f7fe;
  --sg-surface: #ffffff;
  --sg-soft: #eef0fa;
  --sg-canvas: #e5e9fa;
  --sg-text: #222642;
  --sg-muted: #5d637f;
  --sg-line: #dce0f0;
  --sg-brand: #4f55ce;
  --sg-brand-soft: #e8eaff;
  --sg-on-brand: #ffffff;
  --sg-hero-bg: #4951c9;
  --sg-hero-ink: #ffffff;
  --sg-hero-subtle: #e8eaff;
  --sg-hero-control: #3039a1;
  --sg-hero-cta: #fcda90;
  --sg-hero-cta-ink: #34284c;
  --sg-orange: #975727;
  --sg-orange-soft: #fff0cf;
  --sg-yellow: #ffd87e;
  --sg-disabled-bg: #e4e5ee;
  --sg-disabled-text: #656b82;
  --sg-danger: #a72f45;
}
.theme-peach {
  --sg-bg: #fff7f2;
  --sg-surface: #ffffff;
  --sg-soft: #faf0e9;
  --sg-canvas: #f9e4dc;
  --sg-text: #3c292b;
