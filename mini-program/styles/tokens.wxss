}
page, :host, .theme-sky, .theme-peach, .theme-mint {
  --sg-blue: var(--sg-brand);
  --sg-green: var(--sg-brand);
  --sg-green-ink: var(--sg-brand);
  --sg-green-soft: var(--sg-brand-soft);
  --td-brand-color: var(--sg-brand);
  --td-brand-color-light: var(--sg-brand-soft);
  --td-brand-color-focus: var(--sg-brand-soft);
  --td-brand-color-active: var(--sg-brand);
  --td-brand-color-disabled: var(--sg-disabled-bg);
  --td-text-color-secondary: var(--sg-muted);
  --td-text-color-primary: var(--sg-text);
  --td-bg-color-container: var(--sg-surface);
  color: var(--sg-text);
}
