.theme-mint {
  --sg-bg: #f1faf7;
  --sg-surface: #ffffff;
  --sg-soft: #e6f3ef;
  --sg-canvas: #d8efe9;
  --sg-text: #193a38;
  --sg-muted: #506c68;
  --sg-line: #cfe6df;
  --sg-brand: #08796c;
  --sg-brand-soft: #d7f3e9;
